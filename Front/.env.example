# Copy to .env.development.local for local development
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
PUBLIC_ADMIN_API_BASE_URL=http://127.0.0.1:8787
# Pages production and preview: configure each URL separately as an HTTPS Worker.
# PUBLIC_API_BASE_URL is the read-only public Worker.
# PUBLIC_ADMIN_API_BASE_URL is the private Worker protected by Cloudflare Access.
