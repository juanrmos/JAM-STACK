---
/**
 * Layout base — dueño del <head>, inyecta tokens como variables CSS,
 * envuelve nav y footer.
 * Referencia: doc 05 sección 3, skill architecture principio 2.
 */
import { tokens } from "../config/tokens";
import { siteConfig } from "../config/site";
import textos from "../i18n/es";
import "../styles/global.css";

const cssVars = [
  `--color-fondo: ${tokens.color.fondo}`,
  `--color-texto: ${tokens.color.texto}`,
  `--color-primario: ${tokens.color.primario}`,
  `--color-acento: ${tokens.color.acentoSecundario}`,
  `--font-display: ${tokens.tipografia.display}`,
  `--font-cuerpo: ${tokens.tipografia.cuerpo}`,
  `--tam-h1: ${tokens.tipografia.escala.h1}`,
  `--tam-h2: ${tokens.tipografia.escala.h2}`,
  `--tam-cuerpo: ${tokens.tipografia.escala.cuerpo}`,
  `--espaciado-seccion: ${tokens.espaciado.seccion}`,
  `--espaciado-tarjeta: ${tokens.espaciado.tarjeta}`,
  `--radio-base: ${tokens.radio}`,
].join(";");

const whatsappUrl = siteConfig.contacto.whatsapp
  ? `https://wa.me/${siteConfig.contacto.whatsapp}?text=${encodeURIComponent(siteConfig.contacto.mensajeCotizacion)}`
  : "#";
---

<html lang="es" style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- PWA / iOS Config (Ref: pwa-sin-friccion skill) -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#2F4F4F" />

    <meta
      name="description"
      content="Portafolio de arte — murales, retratos y esculturas personalizadas con la maestría del realismo"
    />
    <title>{siteConfig.artista.nombreEstudio}</title>

    <!-- Fonts: Newsreader (display) + DM Sans (fallback de General Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="header">
      <nav class="nav" id="nav-principal">
        <a href="/" class="nav__logo">
          <span class="nav__logo-inicial">{siteConfig.artista.nombreEstudio.split(' ')[0]}</span> {siteConfig.artista.nombreEstudio.split(' ').slice(1).join(' ')}
        </a>
        <div class="nav__links">
          <a href="#inicio" class="nav__link">{textos.nav.inicio}</a>
          <a href="#galeria" class="nav__link">{textos.nav.galeria}</a>
          <a href={whatsappUrl} class="nav__link nav__link--cta" target="_blank" rel="noopener">
            {textos.nav.cotizar}
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <p>
        &copy; {new Date().getFullYear()} {siteConfig.artista.nombreEstudio}.{" "}
        {textos.footer.derechos}
      </p>
    </footer>

    <script>
      import { registrarServiceWorker } from "../lib/pwa/registerServiceWorker";
      registrarServiceWorker();
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-fondo);
    border-bottom: 1px solid rgba(47, 79, 79, 0.06);
    backdrop-filter: blur(8px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-texto);
    letter-spacing: -0.01em;
  }

  .nav__logo-inicial {
    color: var(--color-primario);
    font-weight: 600;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__link {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--color-texto);
    transition: color 0.2s ease;
  }

  .nav__link:hover {
    color: var(--color-primario);
  }

  .nav__link--cta {
    border: 1.5px solid var(--color-primario);
    color: var(--color-primario);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radio-base);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .nav__link--cta:hover {
    background-color: var(--color-primario);
    color: #fff;
  }

  .footer {
    text-align: center;
    padding: 2.5rem 2rem;
    font-size: 0.875rem;
    opacity: 0.5;
    border-top: 1px solid rgba(47, 79, 79, 0.06);
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .nav {
      padding: 1rem 1.25rem;
    }

    .nav__links {
      gap: 1.25rem;
    }

    .nav__link:not(.nav__link--cta) {
      font-size: 0.85rem;
    }
  }
</style>
