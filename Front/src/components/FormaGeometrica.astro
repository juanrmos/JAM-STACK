---
/**
 * Elemento decorativo de marca — polígono facetado/angular.
 * Reemplaza el blob orgánico del mockup original (doc 05, sección 5.2).
 * Usa el color acentoSecundario del token.
 * Puramente decorativo — aria-hidden="true".
 */
---

<div class="forma-geometrica" aria-hidden="true">
  <svg
    viewBox="0 0 400 400"
    xmlns="http://www.w3.org/2000/svg"
    class="forma-geometrica__svg"
  >
    <!-- Capa exterior — opacidad baja -->
    <polygon
      points="200,15 375,105 360,310 200,390 40,310 25,105"
      fill="var(--color-acento)"
      opacity="0.1"
    />
    <!-- Capa intermedia -->
    <polygon
      points="200,55 330,125 318,280 200,345 82,280 70,125"
      fill="var(--color-acento)"
      opacity="0.07"
    />
    <!-- Faceta interior — más sutil -->
    <polygon
      points="200,95 285,145 278,250 200,300 122,250 115,145"
      fill="var(--color-acento)"
      opacity="0.05"
    />
  </svg>
</div>

<style>
  .forma-geometrica {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .forma-geometrica__svg {
    width: 100%;
    height: 100%;
  }
</style>
