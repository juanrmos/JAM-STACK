---
import ObraFormView from "../../visual/components/admin/obras/ObraFormView.astro";
interface Props {
  modo?: "nueva" | "editar";
}
const { modo = "nueva" } = Astro.props;
---
<ObraFormView modo={modo} />
<script>
  import { apiFetch } from "../../lib/auth";
  import { renderSlotsFormulario } from "../../visual/templates/admin/obras";

  // Determinar modo desde la URL
  const params = new URLSearchParams(window.location.search);
  const obraActualId: string | null = params.get("id");
  let ordenElegido: number = 0;
  let categoriaOriginal: string | null = null;
  let ordenOriginal: number = 0;
  let slotsVersion = 0;

  const form = document.getElementById("form-obra") as HTMLFormElement;
  const errorP = document.getElementById("f-error") as HTMLParagraphElement;
  const spinner = document.getElementById("f-spinner") as HTMLDivElement;
  const btn = document.getElementById("f-btn") as HTMLButtonElement;
  const selectCat = document.getElementById("f-cat") as HTMLSelectElement;
  const inputArchivo = document.getElementById("f-archivo") as HTMLInputElement;
  const hintArchivo = document.getElementById("f-archivo-hint");
  const dropzone = document.getElementById("f-dropzone");
  const fileName = document.getElementById("f-file-name");

  function mostrarArchivo() {
    if (fileName) fileName.textContent = inputArchivo.files?.[0]?.name || "Ningún archivo seleccionado";
  }
  inputArchivo.addEventListener('change', mostrarArchivo);
  dropzone?.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropzone.classList.add('campo__dropzone--dragging');
  });
  dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('campo__dropzone--dragging'));
  dropzone?.addEventListener('drop', (event) => {
    event.preventDefault();
    dropzone.classList.remove('campo__dropzone--dragging');
    const files = (event as DragEvent).dataTransfer?.files;
    if (!files?.length) return;
    const transfer = new DataTransfer();
    transfer.items.add(files[0]);
    inputArchivo.files = transfer.files;
    mostrarArchivo();
  });

  // Lógica de purificación de imagen
  const sanitizeImage = async (file: File): Promise<File> => {
    return new Promise((resolve, reject) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement("canvas");
        const MAX_WIDTH = 2000;
        const MAX_HEIGHT = 2000;
        let width = img.width;
        let height = img.height;

        if (width > height) {
          if (width > MAX_WIDTH) {
            height = Math.round((height * MAX_WIDTH) / width);
            width = MAX_WIDTH;
          }
        } else {
          if (height > MAX_HEIGHT) {
            width = Math.round((width * MAX_HEIGHT) / height);
            height = MAX_HEIGHT;
          }
        }

        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d");
        if (!ctx) return reject(new Error("No se pudo procesar la imagen en tu navegador."));

        ctx.drawImage(img, 0, 0, width, height);

        canvas.toBlob((blob) => {
          if (blob) {
            const fileName = file.name.split('.')[0] + '.webp';
            resolve(new File([blob], fileName, { type: 'image/webp' }));
          } else {
            reject(new Error("Error al intentar purificar la imagen."));
          }
        }, "image/webp", 0.9);
      };
      img.onerror = () => reject(new Error("El archivo seleccionado está corrupto o tiene código inyectado."));
      img.src = url;
    });
  };

  // Cargar slots dinámicamente
  async function cargarSlotsFormulario(cat: string) {
    const version = ++slotsVersion;
    const slotsDiv = document.getElementById('f-slots');
    const statusP = document.getElementById('f-slot-status');
    if (!slotsDiv || !statusP) return;
    if (!cat) {
      slotsDiv.innerHTML = '<p class="f-slot-status-message">Elige una categoría para ver sus posiciones.</p>';
      statusP.textContent = '';
      return;
    }

    slotsDiv.innerHTML = '<p class="f-slot-status-message">Cargando posiciones...</p>';

    try {
      const res = await apiFetch(`/api/obras?servicio_id=${cat}&limit=5&slots=true`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (version !== slotsVersion) return;
      const ocupadas = data.obras || [];

      slotsDiv.innerHTML = renderSlotsFormulario(ocupadas, obraActualId, ordenElegido);

      // Manejar Taps
      document.querySelectorAll('.f-slot-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const s = parseInt(target.dataset.slot!);

          if (ordenElegido === s) {
            ordenElegido = 0;
          } else {
            ordenElegido = s;
            if (navigator.vibrate) navigator.vibrate(50);
          }

          document.querySelectorAll('.f-slot-card').forEach(c => {
            c.classList.remove('f-slot-card--selected');
            c.setAttribute('aria-pressed', 'false');
          });
          if (ordenElegido > 0) {
            target.classList.add('f-slot-card--selected');
            target.setAttribute('aria-pressed', 'true');
            statusP.textContent = `Posición ${ordenElegido} seleccionada.`;
          } else {
            statusP.textContent = '';
          }
        });
      });

      if (ordenElegido > 0) {
        statusP.textContent = `Posición ${ordenElegido} seleccionada.`;
      } else {
        statusP.textContent = '';
      }

    } catch(e) {
      if (version === slotsVersion) slotsDiv.innerHTML = '<p class="f-slot-status-message f-slot-status-message--error">Error al cargar posiciones</p>';
    }
  }

  selectCat.addEventListener('change', (e) => {
    const cat = (e.target as HTMLSelectElement).value;
    if (cat === categoriaOriginal) {
      ordenElegido = ordenOriginal;
    } else {
      ordenElegido = 0;
    }
    cargarSlotsFormulario(cat);
  });

  // AUTO-INIT: si hay ?id= en la URL, cargar los datos de la obra
  async function inicializar() {
    if (obraActualId) {
      // Modo edición
      inputArchivo.removeAttribute('required');
      hintArchivo?.classList.remove('admin-hidden');

      try {
        const res = await apiFetch(`/api/obras/${obraActualId}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const obra = await res.json();

        if (obra && !obra.error) {
          (document.getElementById('f-titulo') as HTMLInputElement).value = obra.titulo;
          (document.getElementById('f-desc') as HTMLTextAreaElement).value = obra.descripcion || '';
          (document.getElementById('f-video') as HTMLInputElement).value = obra.videoUrl || '';

          (document.getElementById('f-ubicacion') as HTMLInputElement).value = obra.ubicacion || '';
          (document.getElementById('f-anio') as HTMLInputElement).value = obra.anio || '';
          (document.getElementById('f-ubicacion') as HTMLInputElement).value = obra.ubicacion || '';
          (document.getElementById('f-anio') as HTMLInputElement).value = obra.anio || '';
          // Registrar el slot actual antes de cargar las posiciones de la categoría.
          categoriaOriginal = obra.servicio_id;
          ordenOriginal = obra.destacado_slot ?? 0;
          ordenElegido = obra.destacado_slot ?? 0;
          selectCat.value = obra.servicio_id;
          await cargarSlotsFormulario(obra.servicio_id);

          // Preview de imagen actual
          const previewContainer = document.getElementById('f-imagen-preview-container');
          const previewImg = document.getElementById('f-imagen-preview') as HTMLImageElement;
          if (previewContainer && previewImg && obra.imagenUrl) {
            previewImg.src = obra.imagenUrl;
            previewContainer.classList.remove('admin-hidden');
          }
        }
      } catch (err) {
        console.error("Error precargando obra", err);
        errorP.textContent = "Error al cargar los datos de la obra.";
        errorP.classList.add('formulario-box__error--danger');
      }
    } else {
      // Modo nueva obra — input archivo es obligatorio
      inputArchivo.setAttribute('required', 'true');
      hintArchivo?.classList.add('admin-hidden');
    }
  }

  inicializar();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    spinner.classList.remove('admin-hidden');
    errorP.classList.remove('formulario-box__error--danger');
    btn.disabled = true;

    try {
      const fileInput = document.getElementById("f-archivo") as HTMLInputElement;
      const rawFile = fileInput.files?.[0];

      let payload: any = {
        titulo: (document.getElementById("f-titulo") as HTMLInputElement).value,
        descripcion: (document.getElementById("f-desc") as HTMLTextAreaElement).value || (obraActualId ? null : undefined),
        servicio_id: selectCat.value,
        videoUrl: (document.getElementById("f-video") as HTMLInputElement).value || (obraActualId ? null : undefined),
        ubicacion: (document.getElementById('f-ubicacion') as HTMLInputElement).value || null,
        anio: Number((document.getElementById('f-anio') as HTMLInputElement).value) || null,
        destacado_slot: ordenElegido || null
      };

      if (rawFile) {
        errorP.textContent = "Preparando imagen...";
        errorP.classList.remove('formulario-box__error--danger');
        const file = await sanitizeImage(rawFile);

        const urlRes = await apiFetch("/api/obras/upload-url", {
          method: "POST",
          body: JSON.stringify({ nombreArchivo: file.name, tipoMime: file.type })
        });

        if (!urlRes.ok) throw new Error("Error al obtener permisos de subida.");
        const { uploadUrl, imagenKey } = await urlRes.json();

        errorP.textContent = "Transfiriendo imagen...";
        const putRes = await fetch(uploadUrl, {
          method: "PUT",
          headers: { "Content-Type": file.type },
          body: file
        });
        if (!putRes.ok) throw new Error("Error subiendo el archivo a R2.");

        payload.imagenKey = imagenKey;
      }

      errorP.textContent = "Guardando datos...";

      if (obraActualId) {
        const saveRes = await apiFetch(`/api/obras/${obraActualId}`, {
          method: "PUT",
          body: JSON.stringify(payload)
        });
        if (!saveRes.ok) throw new Error("Error al actualizar la obra.");
      } else {
        if (!payload.imagenKey) throw new Error("Debes subir una foto para una nueva obra.");
        const saveRes = await apiFetch("/api/obras", {
          method: "POST",
          body: JSON.stringify(payload)
        });
        if (!saveRes.ok) throw new Error("Error al guardar la metadata.");
      }

      // Éxito — volver al dashboard
      window.location.href = "/admin/obras";

    } catch (err: any) {
      errorP.textContent = "Error: " + err.message;
      errorP.classList.add('formulario-box__error--danger');
      spinner.classList.add('admin-hidden');
    } finally {
      btn.disabled = false;
    }
  });
</script>
