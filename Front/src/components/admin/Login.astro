---
import LoginView from "../../visual/components/admin/login/LoginView.astro";
---
<LoginView />
<script>
  import { apiFetch, setToken } from "../../lib/auth";

  const form = document.getElementById("form-login") as HTMLFormElement;
  const input = document.getElementById("input-secreto") as HTMLInputElement;
  const btn = document.getElementById("btn-login") as HTMLButtonElement;
  const errorMsg = document.getElementById("login-error") as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg.textContent = "";
    btn.disabled = true;
    btn.textContent = "Verificando...";

    try {
      const res = await apiFetch("/api/auth/login", {
        method: "POST",
        body: JSON.stringify({ secreto: input.value }),
      });

      if (!res.ok) {
        throw new Error("Secreto incorrecto o error de red");
      }

      const data = await res.json();
      setToken(data.token);
      input.value = "";
      window.location.href = "/admin/obras";
    } catch (err: any) {
      errorMsg.textContent = err.message;
    } finally {
      btn.disabled = false;
      btn.textContent = "Ingresar";
    }
  });
</script>
