---
---

<div class="login-box">
  <h1 class="login-box__titulo">Acceso Privado</h1>
  <p class="login-box__desc">Ingresa el secreto de administrador para gestionar el portafolio.</p>

  <form id="form-login" class="login-box__form">
    <input
      type="password"
      id="input-secreto"
      placeholder="Secreto de administrador..."
      class="login-box__input"
      required
    />
    <button type="submit" class="login-box__btn" id="btn-login">
      Ingresar
    </button>
    <p id="login-error" class="login-box__error"></p>
  </form>
</div>

<script>
  import { apiFetch, setToken } from "../../lib/auth";

  const form = document.getElementById("form-login") as HTMLFormElement;
  const input = document.getElementById("input-secreto") as HTMLInputElement;
  const btn = document.getElementById("btn-login") as HTMLButtonElement;
  const errorMsg = document.getElementById("login-error") as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg.textContent = "";
    btn.disabled = true;
    btn.textContent = "Verificando...";

    try {
      const res = await apiFetch("/api/auth/login", {
        method: "POST",
        body: JSON.stringify({ secreto: input.value }),
      });

      if (!res.ok) {
        throw new Error("Secreto incorrecto o error de red");
      }

      const data = await res.json();
      setToken(data.token);
      input.value = "";
      
      // Llamar a la función global para cambiar al dashboard
      (window as any).revisarSesion();
    } catch (err: any) {
      errorMsg.textContent = err.message;
    } finally {
      btn.disabled = false;
      btn.textContent = "Ingresar";
    }
  });
</script>

<style>
  .login-box {
    max-width: 400px;
    margin: 0 auto;
    background: #fff;
    padding: 3rem 2rem;
    border-radius: var(--radio-base);
    box-shadow: 0 12px 32px rgba(47, 79, 79, 0.08);
    text-align: center;
  }

  .login-box__titulo {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-texto);
    margin-bottom: 0.5rem;
  }

  .login-box__desc {
    color: var(--color-texto);
    opacity: 0.7;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .login-box__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .login-box__input {
    padding: 0.875rem 1rem;
    border: 1px solid rgba(47, 79, 79, 0.2);
    border-radius: var(--radio-base);
    font-family: var(--font-cuerpo);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .login-box__input:focus {
    border-color: var(--color-primario);
  }

  .login-box__btn {
    background: var(--color-texto);
    color: #fff;
    border: none;
    padding: 0.875rem;
    border-radius: var(--radio-base);
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .login-box__btn:hover {
    opacity: 0.9;
  }

  .login-box__btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .login-box__error {
    color: #e53e3e;
    font-size: 0.875rem;
    margin-top: 0.5rem;
    min-height: 1.2rem;
  }
</style>
