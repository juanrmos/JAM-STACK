---
---
<div class="dashboard">
  <div class="dashboard__header">
    <h2 class="dashboard__titulo">Tus Obras</h2>
    <div style="display: flex; gap: 1rem;">
      <button class="dashboard__btn-add" onclick="window.navegarAdmin('formulario')">
        + Nueva Obra
      </button>
      <button class="dashboard__btn-logout" id="btn-logout">Cerrar Sesión</button>
    </div>
  </div>

  <div id="obras-lista" class="dashboard__lista">
    <p>Cargando obras...</p>
  </div>
</div>

<script>
  import { apiFetch, removeToken } from "../../lib/auth";

  const contenedor = document.getElementById("obras-lista");
  
  document.getElementById("btn-logout")?.addEventListener("click", () => {
    removeToken();
    (window as any).revisarSesion();
  });

  async function cargarObras() {
    if (!contenedor) return;
    contenedor.innerHTML = "<p>Cargando obras...</p>";
    try {
      const res = await apiFetch("/api/obras");
      if (!res.ok) throw new Error("Error al cargar");
      const data = await res.json();
      const obras = data.obras || [];
      
      if (obras.length === 0) {
        contenedor.innerHTML = "<p>No hay obras en tu portafolio. ¡Sube la primera!</p>";
        return;
      }

      contenedor.innerHTML = obras.map((o: any) => `
        <div class="obra-card">
          <img src="${o.imagenUrl}" alt="${o.titulo}" class="obra-card__img" loading="lazy" />
          <div class="obra-card__info">
            <strong>${o.titulo}</strong>
            <span>${o.categoria || 'Sin categoría'} | Orden: ${o.orden}</span>
          </div>
          <button class="btn-borrar" data-id="${o.id}">🗑️</button>
        </div>
      `).join('');

      document.querySelectorAll('.btn-borrar').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLButtonElement).dataset.id;
          if (confirm("¿Seguro que deseas borrar esta obra? Esto no se puede deshacer.")) {
            try {
              (e.currentTarget as HTMLButtonElement).disabled = true;
              await apiFetch(`/api/obras/${id}`, { method: "DELETE" });
              cargarObras();
            } catch (err) {
              alert("Error al borrar");
            }
          }
        });
      });

    } catch (err) {
      contenedor.innerHTML = "<p>Error al cargar las obras. Verifica tu conexión.</p>";
    }
  }

  window.addEventListener('admin:load-dashboard', cargarObras);
</script>

<style>
  .dashboard {
    background: #fff;
    border-radius: var(--radio-base);
    box-shadow: 0 12px 32px rgba(47, 79, 79, 0.08);
    padding: 2rem;
  }
  .dashboard__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(47, 79, 79, 0.1);
  }
  .dashboard__titulo {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--color-texto);
  }
  .dashboard__btn-add {
    background: var(--color-primario);
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: var(--radio-base);
    font-weight: 600;
    cursor: pointer;
  }
  .dashboard__btn-logout {
    background: transparent;
    color: var(--color-texto);
    border: 1px solid rgba(47, 79, 79, 0.2);
    padding: 0.5rem 1rem;
    border-radius: var(--radio-base);
    cursor: pointer;
  }
  .dashboard__lista {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .obra-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem;
    border: 1px solid rgba(47, 79, 79, 0.1);
    border-radius: var(--radio-base);
  }
  .obra-card__img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
  }
  .obra-card__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .obra-card__info strong {
    font-size: 1.1rem;
    color: var(--color-texto);
  }
  .obra-card__info span {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .btn-borrar {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    opacity: 0.6;
  }
  .btn-borrar:hover {
    opacity: 1;
    color: red;
  }
</style>
