---
import ObrasListView from "../../visual/components/admin/obras/ObrasListView.astro";

---
<ObrasListView />
<script>
  import { apiFetch } from "../../lib/auth";
  import { renderSlotsObras, renderTarjetasObras } from "../../visual/templates/admin/obras";

  const slotsContainer = document.getElementById("slots-riel");
  const grillaContainer = document.getElementById("obras-grilla");
  const filtroCat = document.getElementById("filtro-categoria") as HTMLSelectElement;
  const filtroBuscar = document.getElementById("filtro-buscar") as HTMLInputElement;

  let currentTimer: any = null;
  let slotsVersion = 0;
  let gridVersion = 0;

  async function cargarSlots(categoria: string, version: number) {
    if (!slotsContainer) return;
    slotsContainer.innerHTML = "<p>Cargando slots...</p>";
    try {
      const res = await apiFetch(`/api/obras?categoria=${categoria}&limit=5&orden=1-5`);
      if (!res.ok) throw new Error("Error fetching slots");
      const data = await res.json();
      if (version !== slotsVersion) return;
      const obras = data.obras || [];

      slotsContainer.innerHTML = renderSlotsObras(obras);

      // Eventos de slots
      document.querySelectorAll('.slot-card--ocupado, .btn-slot-editar').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.id;
          if (id) {
            window.location.href = `/admin/obras/editar?id=${id}`;
          }
        });
      });
    } catch (e) {
      if (version === slotsVersion) slotsContainer.innerHTML = "<p>Error al cargar posiciones destacadas.</p>";
    }
  }

  async function cargarGrilla(pagina: number, version: number) {
    if (!grillaContainer) return;
    grillaContainer.innerHTML = "<p>Cargando obras...</p>";

    const categoria = filtroCat.value;
    const buscar = filtroBuscar.value;
    const limit = 10;
    const offset = (pagina - 1) * limit;

    try {
      let url = `/api/obras?categoria=${categoria}&limit=${limit}&offset=${offset}`;
      if (buscar.trim()) {
        url += `&buscar=${encodeURIComponent(buscar)}`;
      }

      const res = await apiFetch(url);
      if (!res.ok) throw new Error("Error fetching grilla");
      const data = await res.json();
      if (version !== gridVersion) return;
      const obras = data.obras || [];
      const totalItems = data.total || 0;

      grillaContainer.innerHTML = renderTarjetasObras(obras);
      if (obras.length > 0) {

        // Eventos de grilla
        document.querySelectorAll('.btn-grilla-editar').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLButtonElement).dataset.id;
            if (id) {
              window.location.href = `/admin/obras/editar?id=${id}`;
            }
          });
        });

        document.querySelectorAll('.btn-grilla-borrar').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const id = (e.currentTarget as HTMLButtonElement).dataset.id;
            if (id && confirm("¿Seguro que deseas borrar esta obra? Esta acción no se puede deshacer.")) {
              const button = e.currentTarget as HTMLButtonElement;
              try {
                button.disabled = true;
                const response = await apiFetch(`/api/obras/${id}`, { method: "DELETE" });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                await cargarDashboard(1);
              } catch (err) {
                alert("Error al borrar la obra.");
                button.disabled = false;
              }
            }
          });
        });
      }

      // Actualizar paginador
      const totalPaginas = Math.ceil(totalItems / limit) || 1;
      window.dispatchEvent(new CustomEvent('admin:load-dashboard-obras:update-pagination', {
        detail: { pagina, totalPaginas, totalItems }
      }));
    } catch (e) {
      if (version === gridVersion) grillaContainer.innerHTML = "<p>Error al cargar la grilla.</p>";
    }
  }

  async function cargarDashboard(pagina = 1) {
    await Promise.all([cargarSlots(filtroCat.value, ++slotsVersion), cargarGrilla(pagina, ++gridVersion)]);
  }

  // Escuchar filtros
  if (filtroCat) {
    filtroCat.addEventListener('change', () => cargarDashboard(1));
  }
  if (filtroBuscar) {
    filtroBuscar.addEventListener('input', () => {
      clearTimeout(currentTimer);
      currentTimer = setTimeout(() => {
        cargarGrilla(1, ++gridVersion);
      }, 300);
    });
  }

  window.addEventListener('admin:load-dashboard-obras', () => cargarDashboard(1));
  window.addEventListener('admin:load-dashboard', () => cargarDashboard(1));

  window.addEventListener('admin:load-dashboard-obras:request-page', (e: any) => {
    cargarGrilla(e.detail.pagina, ++gridVersion);
  });
  cargarDashboard(1);
</script>
