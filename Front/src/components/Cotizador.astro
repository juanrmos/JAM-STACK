---
/**
 * Cotizador — drawer lateral que se desliza desde la derecha.
 * Recolecta datos del cliente y construye un mensaje para WhatsApp.
 * Referencia: Builder.io mockup, estilo Brutalismo.
 */
import { siteConfig } from "../config/site";
import textos from "../i18n/es";
---

<div id="cotizador-overlay" class="cotizador-overlay"></div>
<aside id="cotizador-drawer" class="cotizador">
  <button id="cotizador-cerrar" class="cotizador__cerrar" aria-label="Cerrar cotizador">✕</button>
  <div class="cotizador__encabezado">
    <p class="cotizador__eyebrow">J. Art Studio / 01 <br/> Private commissions</p>
    <h2 class="cotizador__titulo">{textos.cotizador.titulo}</h2>
    <p class="cotizador__desc">Por favor comparte los detalles de tu proyecto. Nos pondremos en contacto contigo a la brevedad.</p>
  </div>

  <form id="cotizador-form" class="cotizador__form">
    <input type="text" id="cot-obra" class="cotizador__input" placeholder={textos.cotizador.campos.obra} required />
    <input type="text" id="cot-medidas" class="cotizador__input" placeholder={textos.cotizador.campos.medidas} required />
    
    <select id="cot-ubicacion" class="cotizador__input" required>
      <option value="" disabled selected>{textos.cotizador.campos.ubicacion}</option>
      <option value="interior">Interior</option>
      <option value="exterior">Exterior</option>
    </select>

    <input type="text" id="cot-altura" class="cotizador__input" placeholder={textos.cotizador.campos.altura} required />
    <input type="text" id="cot-direccion" class="cotizador__input" placeholder={textos.cotizador.campos.direccion} required />
    <input type="text" id="cot-referencia" class="cotizador__input" placeholder={textos.cotizador.campos.referencia} required />

    <button type="submit" class="cotizador__enviar">
      {textos.cotizador.enviar}
    </button>
  </form>
</aside>

<script define:vars={{ whatsappNum: siteConfig.contacto.whatsapp }}>
  document.addEventListener("DOMContentLoaded", () => {
    const drawer = document.getElementById("cotizador-drawer");
    const overlay = document.getElementById("cotizador-overlay");
    const btnCerrar = document.getElementById("cotizador-cerrar");
    const form = document.getElementById("cotizador-form");

    const abrir = () => {
      drawer?.classList.add("open");
      overlay?.classList.add("open");
      document.body.style.overflow = "hidden";
    };

    const cerrar = () => {
      drawer?.classList.remove("open");
      overlay?.classList.remove("open");
      document.body.style.overflow = "";
    };

    // Escuchar clics en los botones "Cotizar" del navbar y del hero
    document.getElementById("nav-cotizar-btn")?.addEventListener("click", abrir);
    document.getElementById("hero-cotizar-btn")?.addEventListener("click", abrir);
    btnCerrar?.addEventListener("click", cerrar);
    overlay?.addEventListener("click", cerrar);

    // Enviar a WhatsApp
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const obra = document.getElementById("cot-obra").value;
      const medidas = document.getElementById("cot-medidas").value;
      const ubicacion = document.getElementById("cot-ubicacion").value;
      const altura = document.getElementById("cot-altura").value;
      const direccion = document.getElementById("cot-direccion").value;
      const referencia = document.getElementById("cot-referencia").value;

      const mensaje = `Hola, quiero cotizar un mural de ${obra} de ${medidas}, ${ubicacion}, ${altura}. Te comparto mi direccion: ${direccion}, ${referencia}.`;

      const url = `https://wa.me/${whatsappNum}?text=${encodeURIComponent(mensaje)}`;
      window.open(url, "_blank");
      cerrar();
      form.reset();
    });
  });
</script>

<style>
  /* ---- Overlay oscuro ---- */
  .cotizador-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .cotizador-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  /* ---- Drawer lateral ---- */
  .cotizador {
    position: fixed;
    top: 0;
    right: -50%;
    width: 50%;
    max-width: 520px;
    height: 100%;
    background: var(--color-fondo);
    border-left: 1px solid var(--color-borde);
    z-index: 999;
    padding: 4rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    transition: right 0.5s cubic-bezier(0.65, 0, 0.35, 1);
    overflow-y: auto;
  }

  .cotizador.open {
    right: 0;
  }

  .cotizador__cerrar {
    align-self: flex-end;
    background: none;
    border: none;
    color: var(--color-texto);
    font-size: 1.75rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .cotizador__cerrar:hover {
    color: var(--color-primario);
  }

  .cotizador__encabezado {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cotizador__eyebrow {
    font-size: 0.75rem; /* 12px */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-texto-sec);
  }

  .cotizador__desc {
    font-size: 0.875rem; /* 14px */
    color: var(--color-texto-sec);
  }

  .cotizador__titulo {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    color: var(--color-texto);
    line-height: 1.1;
  }

  .cotizador__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: 1;
  }

  .cotizador__input {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-borde);
    color: var(--color-texto);
    font-family: var(--font-cuerpo);
    font-size: 1.125rem; /* 18px */
    padding: 1rem 0;
    outline: none;
    width: 100%;
    transition: border-color 0.2s ease;
  }

  .cotizador__input:focus {
    border-color: var(--color-primario);
  }

  .cotizador__input::placeholder {
    font-size: 0.6875rem; /* 11px */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-texto-sec);
  }

  .cotizador__textarea {
    resize: none;
    min-height: 80px;
  }

  select.cotizador__input {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    border-radius: 0;
  }

  select.cotizador__input option {
    background: var(--color-fondo);
    color: var(--color-texto);
  }

  .cotizador__enviar {
    margin-top: auto;
    background: var(--color-primario);
    color: #fff;
    font-family: var(--font-cuerpo);
    font-size: 1.125rem; /* 18px */
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1.25rem;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .cotizador__enviar:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .cotizador {
      width: 100%;
      max-width: none;
      right: -100%;
      padding: 2.5rem 1.5rem;
    }
  }
</style>
