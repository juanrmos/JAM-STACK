---
/**
 * Galería — rieles horizontales estilo Netflix.
 * Cada categoría tiene su propio carrusel deslizable.
 * Las imágenes están en escala de grises y pasan a color al hover.
 * Conserva la lógica del Modal de video.
 * Referencia: Builder.io mockup sección 3.
 */
import textos from "../i18n/es";
import { siteConfig } from "../config/site";
---

<section id="galeria" class="galeria">
  <div class="galeria__header">
    <div>
      <p class="galeria__eyebrow">{textos.galeria.eyebrow}</p>
      <h2 class="galeria__titulo">{textos.galeria.titulo}</h2>
    </div>
    {textos.galeria.subtitulo && <p class="galeria__subtitulo">{textos.galeria.subtitulo}</p>}
  </div>

  <div id="rieles-container">
    <!-- Los rieles se generan dinámicamente mediante JavaScript -->
  </div>

  <!-- Template para tarjetas del riel -->
  <template id="riel-tarjeta-template">
    <div class="riel-tarjeta">
      <img src="" alt="" class="riel-tarjeta__img" loading="lazy" />
      <div class="riel-tarjeta__info">
        <h4 class="riel-tarjeta__titulo"></h4>
      </div>
      <div class="riel-tarjeta__video-badge" style="display: none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
      </div>
    </div>
  </template>

  <!-- Reproductor de Video Emergente (Modal) -->
  <dialog id="video-modal" class="modal-video">
    <div class="modal-video__contenido">
      <button id="modal-video-cerrar" class="modal-video__cerrar" aria-label="Cerrar video">✕</button>
      <div class="modal-video__iframe-wrapper">
        <iframe id="modal-video-iframe" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </dialog>
</section>

<script define:vars={{ apiUrl: siteConfig.api.baseUrl }}>
  document.addEventListener("DOMContentLoaded", async () => {
    const container = document.getElementById("rieles-container");
    const template = document.getElementById("riel-tarjeta-template");

    if (!container || !template) return;

    const categoriasMap = {
      mural: "Murales",
      cuadro: "Cuadros al Óleo",
      escultura: "Esculturas",
      restauracion: "Restauración",
      logo: "Diseños"
    };

    const ordenDefecto = ["mural", "cuadro", "escultura", "restauracion", "logo", "otros"];

    const limit = 5;
    const estadoRieles = {}; // Guardará offset y hasMore por categoría

    try {
      let rielesHTML = "";
      
      // 1. Fetch inicial paralelo para todas las categorías
      const promesas = ordenDefecto.map(cat => 
        fetch(`${apiUrl}/api/obras?categoria=${cat}&limit=${limit}&offset=0`)
          .then(res => res.ok ? res.json() : { obras: [], hasMore: false, total: 0 })
          .then(data => ({ cat, data }))
      );

      const resultados = await Promise.all(promesas);
      let totalObras = 0;

      // 2. Generar contenedores de rieles
      resultados.forEach(({ cat, data }) => {
        if (data.obras && data.obras.length > 0) {
          totalObras += data.obras.length;
          estadoRieles[cat] = { offset: data.obras.length, hasMore: data.hasMore, loading: false };
          const titulo = categoriasMap[cat] || "Otras Obras";
          
          rielesHTML += `
            <div class="galeria__riel">
              <div class="galeria__riel-header">
                <h3 class="galeria__riel-titulo">${titulo}</h3>
                <div class="galeria__riel-nav" id="nav-${cat}">
                  <button class="galeria__riel-btn dyn-riel-btn" data-riel="${cat}" data-dir="-1" aria-label="Anterior">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                  </button>
                  <button class="galeria__riel-btn dyn-riel-btn" data-riel="${cat}" data-dir="1" aria-label="Siguiente" ${!data.hasMore ? 'disabled style="opacity: 0.3;"' : ''}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                  </button>
                </div>
              </div>
              <div class="galeria__riel-scroll" id="riel-${cat}"></div>
            </div>
          `;
        }
      });

      if (totalObras === 0) {
        container.innerHTML = "<p style='color: var(--color-texto-sec); padding: 1rem 5vw;'>Aún no hay obras publicadas en el portafolio.</p>";
        return;
      }

      container.innerHTML = rielesHTML;

      // 3. Función para inyectar tarjetas en el DOM
      const inyectarObras = (cat, obras) => {
        const scrollContainer = document.getElementById(`riel-${cat}`);
        if (!scrollContainer) return;

        obras.forEach(obra => {
          const clone = template.content.cloneNode(true);
          const card = clone.querySelector(".riel-tarjeta");
          const img = clone.querySelector("img");
          const titulo = clone.querySelector(".riel-tarjeta__titulo");
          
          // Asignar modificador de aspecto según categoría
          if (cat === 'mural') card.classList.add('riel-tarjeta--mural');
          else if (cat === 'cuadro') card.classList.add('riel-tarjeta--cuadro');
          else card.classList.add('riel-tarjeta--default');

          img.src = obra.imagenUrl;
          img.alt = obra.titulo;
          titulo.textContent = obra.titulo;

          if (obra.videoUrl) {
            clone.querySelector(".riel-tarjeta__video-badge").style.display = "flex";
            card.dataset.videoUrl = obra.videoUrl;
          }

          scrollContainer.appendChild(clone);
        });
      };

      // Inyectar carga inicial
      resultados.forEach(({ cat, data }) => {
        if (data.obras && data.obras.length > 0) {
          inyectarObras(cat, data.obras);
        }
      });

      // 4. Lógica de navegación y Lazy Loading
      document.querySelectorAll(".dyn-riel-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const cat = btn.dataset.riel;
          const dir = parseInt(btn.dataset.dir);
          const riel = document.getElementById(`riel-${cat}`);
          const estado = estadoRieles[cat];
          
          if (!riel) return;
          
          // Mover scroll
          const cardWidth = riel.querySelector('.riel-tarjeta').offsetWidth;
          riel.scrollBy({ left: dir * (cardWidth + 20), behavior: "smooth" });

          // Lazy Loading si vamos hacia adelante, hay más, y no estamos cargando
          if (dir === 1 && estado.hasMore && !estado.loading) {
            // Verificar si estamos cerca del final del scroll
            const scrollMax = riel.scrollWidth - riel.clientWidth;
            if (riel.scrollLeft >= scrollMax - (cardWidth * 2)) {
              estado.loading = true;
              try {
                const url = `${apiUrl}/api/obras?categoria=${cat}&limit=${limit}&offset=${estado.offset}`;
                const resLoad = await fetch(url);
                if (resLoad.ok) {
                  const dataLoad = await resLoad.json();
                  if (dataLoad.obras && dataLoad.obras.length > 0) {
                    inyectarObras(cat, dataLoad.obras);
                    estado.offset += dataLoad.obras.length;
                    estado.hasMore = dataLoad.hasMore;
                    
                    if (!estado.hasMore) {
                       btn.disabled = true;
                       btn.style.opacity = "0.3";
                    }
                  }
                }
              } catch(e) {
                console.error("Error loading more", e);
              }
              estado.loading = false;
            }
          }
        });
      });

    } catch (error) {
      container.innerHTML = "<p style='color: var(--color-texto-sec); padding: 1rem 5vw;'>Error al cargar las obras.</p>";
    }

    // Lógica del Reproductor de Video (Modal)
    const modal = document.getElementById("video-modal");
    const iframe = document.getElementById("modal-video-iframe");
    const btnCerrar = document.getElementById("modal-video-cerrar");

    const cerrarModal = () => {
      modal.close();
      iframe.src = "";
    };

    btnCerrar?.addEventListener("click", cerrarModal);
    
    modal?.addEventListener("click", (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        cerrarModal();
      }
    });

    // Event delegation para toda la galería
    document.getElementById("galeria")?.addEventListener("click", (e) => {
      const tarjeta = e.target.closest(".riel-tarjeta");
      if (tarjeta && tarjeta.dataset.videoUrl) {
        e.preventDefault();
        let url = tarjeta.dataset.videoUrl;
        
        // Reset a formato horizontal por defecto
        modal.classList.remove("is-vertical");

        if (url.includes("watch?v=")) {
          const videoId = new URL(url).searchParams.get("v");
          url = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
        } else if (url.includes("youtu.be/")) {
          const videoId = url.split("youtu.be/")[1]?.split("?")[0];
          url = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
        } else if (url.includes("tiktok.com/")) {
          // TikTok bloquea conexiones por iframe en navegadores modernos
          // La solución más elegante y confiable es abrir el tiktok en una pestaña nueva
          window.open(url, "_blank");
          return; // Salir de la función para no abrir el modal
        }
        
        iframe.src = url;
        modal.showModal();
      }
    });
  });
</script>

<style>
  .galeria {
    padding: var(--espaciado-seccion) 2rem;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--color-borde);
    overflow: hidden;
  }

  .galeria__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.5rem;
    gap: 2rem;
  }

  .galeria__eyebrow {
    font-family: var(--font-cuerpo);
    font-size: 0.625rem; /* 10px */
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primario);
    margin-bottom: 0.75rem;
  }

  .galeria__titulo {
    font-family: var(--font-display);
    font-size: var(--tam-h2);
    color: var(--color-texto);
    font-weight: 400;
  }

  .galeria__subtitulo {
    font-size: 0.875rem; /* 14px */
    color: var(--color-texto-sec);
    max-width: 380px;
    line-height: 1.6;
    text-align: right;
  }

  /* ---- Rieles ---- */
  .galeria__riel {
    margin-bottom: 3rem;
  }

  .galeria__riel-header {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .galeria__riel-titulo {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    color: var(--color-texto);
  }

  .galeria__riel-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .galeria__riel-btn {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-borde);
    border-radius: 50%;
    background: var(--color-fondo);
    color: var(--color-texto);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    flex-shrink: 0;
  }

  .galeria__riel-btn:hover:not(:disabled) {
    border-color: var(--color-texto);
    background: var(--color-texto);
    color: #fff;
    transform: scale(1.05);
  }

  .galeria__riel-btn:disabled {
    cursor: not-allowed;
    opacity: 0.3;
  }

  .galeria__riel-btn svg {
    transition: transform 0.3s ease;
  }

  .galeria__riel-btn[data-dir="-1"]:hover svg {
    transform: translateX(-2px);
  }

  .galeria__riel-btn[data-dir="1"]:hover svg {
    transform: translateX(2px);
  }

  .galeria__riel-scroll {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .galeria__riel-scroll::-webkit-scrollbar {
    display: none;
  }

  /* ---- Tarjetas del riel ---- */
  .riel-tarjeta {
    position: relative;
    flex-shrink: 0;
    /* Responsive width: 72vw mobile, 42vw tablet, 28vw desktop, 22vw lg */
    width: 72vw;
    overflow: hidden;
    scroll-snap-align: start;
    cursor: pointer;
  }
  @media (min-width: 768px) { .riel-tarjeta { width: 42vw; } }
  @media (min-width: 1024px) { .riel-tarjeta { width: 28vw; } }
  @media (min-width: 1440px) { .riel-tarjeta { width: 22vw; } }

  .riel-tarjeta--mural { aspect-ratio: 16 / 9; }
  .riel-tarjeta--cuadro { aspect-ratio: 3 / 4; }
  .riel-tarjeta--default { aspect-ratio: 1 / 1; }

  .riel-tarjeta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.5s ease, transform 0.4s ease;
  }

  .riel-tarjeta:hover .riel-tarjeta__img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }
  
  .riel-tarjeta__info {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    color: #fff;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .riel-tarjeta:hover .riel-tarjeta__info {
    opacity: 1;
    transform: translateY(0);
  }
  .riel-tarjeta__titulo {
    font-family: var(--font-display);
    font-size: 1.5rem; /* 24px */
    font-style: italic;
    font-weight: 400;
  }

  .riel-tarjeta__video-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  /* ---- Modal de Video ---- */
  .modal-video {
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    max-width: 1000px;
    width: 90%;
    overflow: visible;
  }

  .modal-video::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }

  .modal-video__contenido {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: 8px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
  }

  .modal-video__iframe-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 8px;
  }

  .modal-video__iframe-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .modal-video__cerrar {
    position: absolute;
    top: -40px;
    right: 0;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .modal-video__cerrar:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  /* ---- Soporte Vertical (TikTok) ---- */
  .modal-video.is-vertical {
    max-width: 450px;
  }

  .modal-video.is-vertical .modal-video__iframe-wrapper {
    padding-bottom: 177.77%; /* Aspect ratio 9:16 */
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .galeria__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .galeria__subtitulo {
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .modal-video__cerrar {
      top: -36px;
      font-size: 1.75rem;
    }
  }
</style>
