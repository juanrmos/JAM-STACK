---
/**
 * Galería — mosaico editorial de obras.
 * Layout: CSS Grid con obras destacadas que ocupan más espacio (doc 05, 5.3).
 * Fuente de datos: mock por ahora, será fetch a /api/obras.
 * Renderiza <TarjetaObra /> por cada obra.
 */
import textos from "../i18n/es";
import { siteConfig } from "../config/site";
---

<section id="galeria" class="seccion galeria">
  <div class="galeria__header">
    <div>
      <h2 class="galeria__titulo">{textos.galeria.titulo}</h2>
      <p class="galeria__subtitulo">{textos.galeria.subtitulo}</p>
    </div>
  </div>

  <div id="galeria-grid" class="galeria__grid">
    <!-- Se llena dinámicamente con la API -->
  </div>

  <template id="tarjeta-template">
    <article class="tarjeta">
      <img src="" alt="" class="tarjeta__imagen" loading="lazy" />
      <div class="tarjeta__overlay">
        <h3 class="tarjeta__titulo"></h3>
        <p class="tarjeta__descripcion"></p>
      </div>
      <div class="tarjeta__video-badge" aria-label="Esta obra tiene video" style="display: none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>
    </article>
  </template>
  <!-- Reproductor de Video Emergente -->
  <dialog id="video-modal" class="modal-video">
    <div class="modal-video__contenido">
      <button id="modal-video-cerrar" class="modal-video__cerrar" aria-label="Cerrar video">✕</button>
      <div class="modal-video__iframe-wrapper">
        <iframe id="modal-video-iframe" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </dialog>
</section>

<script define:vars={{ apiUrl: siteConfig.api.baseUrl }}>
  document.addEventListener("DOMContentLoaded", async () => {
    const grid = document.getElementById("galeria-grid");
    const template = document.getElementById("tarjeta-template");
    
    if (!grid || !template) return;

    try {
      const res = await fetch(`${apiUrl}/api/obras`);
      if (!res.ok) throw new Error("Error fetching");
      const obras = await res.json();

      grid.innerHTML = "";

      if (obras.length === 0) {
        grid.innerHTML = "<p>Galería vacía. El artista está creando nuevas obras...</p>";
        return;
      }

      obras.forEach((obra) => {
        const clone = template.content.cloneNode(true);
        const article = clone.querySelector('article');
        
        if (obra.destacado) {
          article.classList.add('tarjeta--destacada');
        }

        const img = clone.querySelector('img');
        img.src = obra.imagenUrl;
        img.alt = obra.titulo;

        clone.querySelector('.tarjeta__titulo').textContent = obra.titulo;
        
        const desc = clone.querySelector('.tarjeta__descripcion');
        if (obra.descripcion) {
          desc.textContent = obra.descripcion;
        } else {
          desc.remove();
        }

        if (obra.videoUrl) {
          clone.querySelector('.tarjeta__video-badge').style.display = 'flex';
          article.dataset.videoUrl = obra.videoUrl;
        }

        grid.appendChild(clone);
      });
    } catch (error) {
      grid.innerHTML = "<p>Error al cargar la galería.</p>";
    }

    // Lógica del Reproductor de Video
    const modal = document.getElementById("video-modal");
    const iframe = document.getElementById("modal-video-iframe");
    const btnCerrar = document.getElementById("modal-video-cerrar");

    const cerrarModal = () => {
      modal.close();
      iframe.src = ""; // Detiene la reproducción y limpia la memoria
    };

    btnCerrar?.addEventListener("click", cerrarModal);
    
    // Cerrar al hacer clic en el fondo oscuro
    modal?.addEventListener("click", (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        cerrarModal();
      }
    });

    // Event Delegation: escuchar clics en toda la galería
    grid.addEventListener("click", (e) => {
      const tarjeta = e.target.closest(".tarjeta");
      if (tarjeta && tarjeta.dataset.videoUrl) {
        e.preventDefault();
        
        // Convertir formato de watch?v= a formato /embed/ para iframe
        let url = tarjeta.dataset.videoUrl;
        if (url.includes("watch?v=")) {
          const videoId = new URL(url).searchParams.get("v");
          url = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
        } else if (url.includes("youtu.be/")) {
          const videoId = url.split("youtu.be/")[1]?.split("?")[0];
          url = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
        }
        
        iframe.src = url;
        modal.showModal();
      }
    });

  });
</script>

<style>
  .galeria__header {
    margin-bottom: 2.5rem;
  }

  .galeria__titulo {
    font-family: var(--font-display);
    font-size: var(--tam-h2);
    color: var(--color-texto);
    margin-bottom: 0.5rem;
  }

  .galeria__subtitulo {
    font-size: 1rem;
    color: var(--color-texto);
    opacity: 0.55;
    max-width: 420px;
  }

  /* Mosaico editorial — doc 05 sección 5.3 */
  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    gap: 1rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .galeria__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 240px;
    }
  }

  @media (max-width: 600px) {
    .galeria__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 260px;
    }
  }

  /* Estilos portados de TarjetaObra.astro para el template */
  .tarjeta {
    position: relative;
    border-radius: var(--radio-base);
    overflow: hidden;
    cursor: pointer;
    background: rgba(47, 79, 79, 0.03);
    height: 100%;
    width: 100%;
  }

  .tarjeta__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .tarjeta:hover .tarjeta__imagen {
    transform: scale(1.03);
  }

  .tarjeta__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tarjeta:hover .tarjeta__overlay {
    opacity: 1;
  }

  .tarjeta__titulo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .tarjeta__descripcion {
    font-size: 0.825rem;
    opacity: 0.85;
    line-height: 1.4;
  }

  .tarjeta__video-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border-radius: 50%;
    backdrop-filter: blur(4px);
  }

  .tarjeta--destacada {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media (max-width: 768px) {
    .tarjeta--destacada {
      grid-column: span 1;
      grid-row: span 1;
    }
    .tarjeta__overlay {
      opacity: 1; 
    }
  }
  /* ---- Ventana Emergente de Video (Modal) ---- */
  .modal-video {
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    max-width: 1000px;
    width: 90%;
    overflow: visible;
  }

  .modal-video::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }

  .modal-video__contenido {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: 8px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
  }

  .modal-video__iframe-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* Relación de aspecto 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
  }

  .modal-video__iframe-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .modal-video__cerrar {
    position: absolute;
    top: -40px;
    right: 0;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .modal-video__cerrar:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  @media (max-width: 768px) {
    .modal-video__cerrar {
      top: -36px;
      font-size: 1.75rem;
    }
  }
</style>
