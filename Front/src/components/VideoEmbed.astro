---
/**
 * VideoEmbed — recibe video_url, arma el iframe de YouTube.
 * Referencia: doc 04, sección 2 (componentes).
 * Usa youtube-nocookie.com para mayor privacidad.
 */
interface Props {
  videoUrl: string;
}

const { videoUrl } = Astro.props;

function getYouTubeId(url: string): string | null {
  const match = url.match(
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\n?#]+)/
  );
  return match ? match[1] : null;
}

const videoId = getYouTubeId(videoUrl);
---

{
  videoId && (
    <div class="video-embed">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title="Video de la obra"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      />
    </div>
  )
}

<style>
  .video-embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 */
    margin-top: 0.75rem;
    border-radius: var(--radio-base);
    overflow: hidden;
    background: rgba(47, 79, 79, 0.05);
  }

  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
