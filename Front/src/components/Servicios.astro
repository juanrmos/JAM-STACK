---
/**
 * Servicios — sección "01 / LA PRÁCTICA".
 * Grid de 4 columnas con fotos verticales, números dorados y títulos.
 * Referencia: Builder.io mockup sección 2.
 */
import textos from "../i18n/es";
---

<section id="servicios" class="servicios">
  <div class="servicios__header">
    <div>
      <p class="servicios__eyebrow">{textos.servicios.eyebrow}</p>
      <h2 class="servicios__titulo">{textos.servicios.titulo}</h2>
    </div>
    <p class="servicios__subtitulo">{textos.servicios.subtitulo}</p>
  </div>

  <div class="servicios__grid">
    {textos.servicios.items.map((item) => (
      <div class="servicios__card">
        <div class="servicios__card-img-wrapper">
          <img src={item.imagen} alt={item.titulo} class="servicios__card-img" loading="lazy" />
        </div>
        <div class="servicios__card-body">
          <span class="servicios__card-num">{item.numero}</span>
          <h3 class="servicios__card-titulo">{item.titulo}</h3>
          <p class="servicios__card-sub">{item.subtitulo}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .servicios {
    padding: var(--espaciado-seccion) 2rem;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--color-borde);
  }

  .servicios__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.5rem;
    gap: 2rem;
  }

  .servicios__eyebrow {
    font-family: var(--font-cuerpo);
    font-size: 0.625rem; /* 10px */
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primario);
    margin-bottom: 0.75rem;
  }

  .servicios__titulo {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-texto);
    font-weight: 400;
  }

  .servicios__subtitulo {
    font-size: 0.875rem; /* 14px */
    color: var(--color-texto-sec);
    max-width: 380px;
    line-height: 1.6;
    text-align: right;
  }

  .servicios__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .servicios__card {
    border: 1px solid var(--color-borde);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .servicios__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(47, 79, 79, 0.1);
  }

  .servicios__card-img-wrapper {
    width: 100%;
    height: 280px;
    overflow: hidden;
  }

  .servicios__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .servicios__card:hover .servicios__card-img {
    transform: scale(1.05);
  }

  .servicios__card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .servicios__card-num {
    font-family: var(--font-cuerpo);
    font-size: 0.75rem; /* 12px */
    font-weight: 600;
    color: var(--color-primario);
  }

  .servicios__card-titulo {
    font-family: var(--font-display);
    font-size: 1.875rem; /* 30px */
    font-weight: 400;
    color: var(--color-texto);
  }

  .servicios__card-sub {
    font-family: var(--font-cuerpo);
    font-size: 0.75rem; /* 12px */
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-texto-sec);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .servicios__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .servicios__subtitulo {
      text-align: left;
    }

    .servicios__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .servicios__grid {
      grid-template-columns: 1fr;
    }

    .servicios__card-img-wrapper {
      height: 220px;
    }
  }
</style>
