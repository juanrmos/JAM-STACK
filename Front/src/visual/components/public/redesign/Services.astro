---
import { servicios } from '../../../../config/servicios';
import { nombresPublicosIniciales } from '../../../../../../Shared/contracts/servicios';
import catalogo from '../../../../../../Shared/contracts/textos.json';
import ServiceIntro from './ServiceIntro.astro';

const t = (key: string) => catalogo[key as keyof typeof catalogo]?.valor || '';
---
{servicios.filter((s) => s.id !== 'electricos' && s.id !== 'drywall').map((s) => (
  <section
    class="app-view service-view service-view--gallery"
    data-view-panel={s.id}
    data-service={s.id}
    aria-label={nombresPublicosIniciales[s.id]}
    data-service-name-aria={s.id}
    hidden
  >
    <ServiceIntro
      service={s}
      subtitle={t(`service.${s.id}.subtitle`)}
      description={t(`service.${s.id}.description`)}
    >
      <div class="service-ribbon" data-service-ribbon={s.id}>
        <p class="service-ribbon__count" data-ribbon-count={s.id} aria-live="polite">OBRAS · 0 / 0</p>
        <div class="service-ribbon__row">
          <div class="service-ribbon__viewport service-thumbs" data-ribbon-viewport={s.id} data-thumbs={s.id} aria-label={`Miniaturas de ${nombresPublicosIniciales[s.id]}`} data-service-name-aria={s.id} data-service-name-aria-template="Miniaturas de {name}"></div>
          <div class="service-ribbon__controls" aria-label="Páginas de miniaturas">
            <button type="button" data-ribbon-page="prev" data-service-ribbon-control={s.id} aria-label="Página anterior de miniaturas" disabled>‹</button>
            <button type="button" data-ribbon-page="next" data-service-ribbon-control={s.id} aria-label="Página siguiente de miniaturas" disabled>›</button>
          </div>
        </div>
      </div>
    </ServiceIntro>

    <div class="service-view__gallery" aria-label={`Galería de ${nombresPublicosIniciales[s.id]}`} data-service-name-aria={s.id} data-service-name-aria-template="Galería de {name}">
      <button type="button" class="gallery-arrow" data-slide="prev" aria-label="Obra anterior">←</button>
      <button type="button" class="service-active" data-active-image={s.id} aria-label="Ampliar obra seleccionada">
        <img src={s.imagen} alt="Imagen de referencia del servicio" data-service-cover-fallback={s.id} />
        <span><strong data-service-name-display={s.id}>{nombresPublicosIniciales[s.id]}</strong><small>Selecciona una obra para ampliarla</small></span>
      </button>
      <button type="button" class="gallery-arrow" data-slide="next" aria-label="Obra siguiente">→</button>
    </div>
  </section>
))}

<nav class="service-dock" aria-label="Servicios artísticos">
  {servicios.filter((s) => s.dock && s.id !== 'materiales').map((s) => (
  <button type="button" data-view={s.id} class="dock-card" aria-label={nombresPublicosIniciales[s.id]} data-service-name-aria={s.id}>
      <img src={s.imagen} alt="" loading="lazy" data-service-cover={s.id} />
      <span class="dock-card__number">{s.numero}</span>
      <span class="dock-card__name" data-service-name-display={s.id}>{nombresPublicosIniciales[s.id]}</span>
  </button>
  ))}
  <button type="button" data-view="complementarios" class="dock-card dock-card--group" aria-label="Servicios Complementarios" data-service-group-aria="complementarios">
    <img src="/images/servicio-fachadas.jpg" alt="" loading="lazy" data-service-cover="electricos" />
    <span class="dock-card__number">07</span><span class="dock-card__name" data-service-group-display="complementarios">Servicios Complementarios</span>
  </button>
  {servicios.filter((s) => s.id === 'materiales').map((s) => (
    <button type="button" data-view={s.id} class="dock-card" aria-label={nombresPublicosIniciales[s.id]} data-service-name-aria={s.id}>
      <img src={s.imagen} alt="" loading="lazy" data-service-cover={s.id} />
      <span class="dock-card__number">{s.numero}</span>
      <span class="dock-card__name" data-service-name-display={s.id}>{nombresPublicosIniciales[s.id]}</span>
    </button>
  ))}
</nav>
