---
import defaults from '../../../../../../Shared/contracts/textos.json';
const t=(key:string)=>defaults[key as keyof typeof defaults]?.valor||'';
---
<div class="app-overlay" id="quote-overlay" hidden></div><aside class="quote-panel" id="quote-panel" aria-labelledby="quote-heading" aria-modal="true" role="dialog" hidden>
  <div class="panel-top"><span data-text-key="quote.eyebrow">{t('quote.eyebrow')}</span><button type="button" data-close-quote aria-label="Cerrar cotizador">✕</button></div><h2 id="quote-heading" data-text-key="quote.title">{t('quote.title')}</h2><p class="quote-description" data-text-key="quote.description">{t('quote.description')}</p><p id="quote-steps" class="quote-steps" aria-live="polite">01 Obra · 02 Medidas · 03 Contacto</p>
  <form id="quote-form"><fieldset data-quote-step="0"><legend data-text-key="quote.ideaTitle">{t('quote.ideaTitle')}</legend><p class="quote-step-description" data-text-key="quote.ideaDescription">{t('quote.ideaDescription')}</p><div data-quote-fields="1"></div></fieldset>
    <fieldset data-quote-step="1" hidden><legend data-text-key="quote.measurementsTitle">{t('quote.measurementsTitle')}</legend><p class="quote-step-description" data-text-key="quote.measurementsDescription">{t('quote.measurementsDescription')}</p><div data-quote-fields="2"></div></fieldset>
    <fieldset data-quote-step="2" hidden><legend data-text-key="quote.contactTitle">{t('quote.contactTitle')}</legend><p class="quote-step-description" data-text-key="quote.contactDescription">{t('quote.contactDescription')}</p><div data-quote-fields="3"></div></fieldset>
    <div class="quote-actions"><button type="button" data-quote-back hidden>Volver</button><button type="button" class="gold-button" data-quote-next>Continuar →</button><button type="submit" class="gold-button" data-quote-send hidden>Enviar por WhatsApp ↗</button></div></form></aside>
