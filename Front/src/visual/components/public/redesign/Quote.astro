<div class="app-overlay" id="quote-overlay" hidden></div><aside class="quote-panel" id="quote-panel" aria-labelledby="quote-heading" aria-modal="true" role="dialog" hidden>
  <div class="panel-top"><span>PROYECTO / CONSULTA</span><button type="button" data-close-quote aria-label="Cerrar cotizador">✕</button></div><h2 id="quote-heading">Cotizador</h2><p id="quote-steps" class="quote-steps" aria-live="polite">01 Obra · 02 Medidas · 03 Contacto</p>
  <form id="quote-form"><fieldset data-quote-step="0"><legend>Cuéntanos tu idea</legend><label>Servicio o proyecto<input name="obra" id="quote-service" required placeholder="¿Qué tienes en mente?" /></label><label>Detalles<textarea name="detalles" rows="4" placeholder="Material, estilo o idea"></textarea></label></fieldset>
    <fieldset data-quote-step="1" hidden><legend>Medidas aproximadas</legend><label>Metros cuadrados<input name="metros" type="number" min="0" step="0.1" placeholder="Ej. 12" /></label><label>Entorno<select name="entorno"><option value="">Selecciona una opción</option><option>Interior</option><option>Exterior</option></select></label><label>Piso o altura<input name="altura" placeholder="Ej. primer piso" /></label></fieldset>
    <fieldset data-quote-step="2" hidden><legend>¿Cómo te contactamos?</legend><label>Nombre<input name="nombre" autocomplete="name" /></label><label>Teléfono o WhatsApp<input name="telefono" type="tel" autocomplete="tel" /></label><label>Correo electrónico<input name="correo" type="email" autocomplete="email" /></label></fieldset>
    <div class="quote-actions"><button type="button" data-quote-back hidden>Volver</button><button type="button" class="gold-button" data-quote-next>Continuar →</button><button type="submit" class="gold-button" data-quote-send hidden>Enviar por WhatsApp ↗</button></div></form></aside>
