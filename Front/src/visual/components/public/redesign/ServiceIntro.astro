---
import type { Servicio } from '../../../../config/servicios';
import { nombresPublicosIniciales } from '../../../../../../Shared/contracts/servicios';
import { enlaceWhatsapp } from '../../../../features/cotizacion/whatsapp';

interface Props {
  service: Servicio;
  subtitle: string;
  description: string;
}

const { service, subtitle, description } = Astro.props;
const serviceName = nombresPublicosIniciales[service.id];
---
<div class="service-view__intro">
  <a href="/?vista=inicio" data-view="inicio" class="back-link">← Volver al inicio</a>
  <p class="eyebrow">{service.numero} / <span data-service-name-display={service.id}>{serviceName}</span></p>
  <h1 data-service-name-display={service.id}>{serviceName}</h1>
  <p class="service-view__motto" data-text-key={`service.${service.id}.subtitle`}>{subtitle}</p>
  <p class="service-view__description" data-text-key={`service.${service.id}.description`}>{description}</p>
  {service.cotizaPorWhatsApp
    ? <a class="gold-button" href={enlaceWhatsapp('Hola, deseo consultar por la Venta de Materiales e Insumos.')} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp ↗</a>
    : <button type="button" class="gold-button" data-open-quote data-service-quote={service.id}>Cotizar este servicio ↗</button>}
  <slot />
</div>
