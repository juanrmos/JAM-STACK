---
const { siteConfig, textos } = Astro.props;
import "../../styles/public/footer.css";
---
<footer class="footer">
      <div class="footer__inner">
        <div class="footer__col footer__col--brand">
          <p class="footer__logo">{siteConfig.artista.nombreEstudio}</p>
          <p class="footer__desc">{textos.footer.branding}</p>
          <div class="footer__socials">
            <a href="#" aria-label="Instagram" class="footer__social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="5" /><circle cx="17.5" cy="6.5" r="1.5" /></svg>
            </a>
            <a href="#" aria-label="Behance" class="footer__social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029h3.168zm-7.686-4h4.965c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.488 2.219zM9 15.963c2.514 0 2.943-1.693 2.943-2.755 0-3.228-2.842-2.674-2.842-2.674H2V22h7.156S13 21.58 13 18.68c0-1.988-1.574-2.717-4-2.717zm-4-4.248h4c1.287 0 1.672.852 1.672 1.713 0 .999-.717 1.635-1.793 1.635H5v-3.348zm3.943 9.323H5v-3.804h4.037c1.258 0 1.894.852 1.894 1.9 0 1.145-.752 1.904-1.988 1.904zM9 5H2v2h7V5z"/></svg>
            </a>
          </div>
        </div>
        <div class="footer__col">
          <p class="footer__col-title">{textos.footer.explorar}</p>
          <a href="#inicio" class="footer__col-link">{textos.nav.inicio}</a>
          <a href="#servicios" class="footer__col-link">{textos.nav.servicios}</a>
          {siteConfig.secciones.galeria && <a href="#galeria" class="footer__col-link">{textos.nav.galeria}</a>}
        </div>
        <div class="footer__col">
          <p class="footer__col-title">{textos.footer.estudio}</p>
          <p class="footer__col-link">📍 {textos.footer.ubicacion}</p>
        </div>
      </div>
      <div class="footer__bottom">
        <p>&copy; {new Date().getFullYear()} {siteConfig.artista.nombreEstudio.toUpperCase()}</p>
        <p>{textos.footer.lema}</p>
      </div>
    </footer>
