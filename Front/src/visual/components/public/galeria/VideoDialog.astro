---
import "../../../styles/public/galeria/video-dialog.css";
---
<dialog id="video-modal" class="modal-video">
    <div class="modal-video__contenido">
      <button id="modal-video-cerrar" class="modal-video__cerrar" aria-label="Cerrar video">✕</button>
      <div class="modal-video__iframe-wrapper">
        <iframe id="modal-video-iframe" src="" title="Video de la obra" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </dialog>