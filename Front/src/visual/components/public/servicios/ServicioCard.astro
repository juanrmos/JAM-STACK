---
import type { Servicio } from '../../../../config/servicios';
import '../../../styles/public/servicios/card.css';
import { nombresPublicosIniciales } from '../../../../../../Shared/contracts/servicios';
interface Props { item: Servicio }
const { item } = Astro.props;
---
<div class="servicios__card">
  <div class="servicios__card-img-wrapper">
    <img src={item.imagen} alt={nombresPublicosIniciales[item.id]} class="servicios__card-img" loading="lazy" />
  </div>
  <div class="servicios__card-body">
    <span class="servicios__card-num">{item.numero}</span>
    <h3 class="servicios__card-titulo">{nombresPublicosIniciales[item.id]}</h3>
    <p class="servicios__card-sub">{item.numero}</p>
  </div>
</div>
