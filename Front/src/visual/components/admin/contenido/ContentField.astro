---
interface Props {
  fieldKey: string;
  label: string;
  initialValue: string;
  limit: number;
  multiline: boolean;
  rows: number;
  formId?: string;
}

const { fieldKey, label, initialValue, limit, multiline, rows, formId = 'content-form' } = Astro.props;
---

<label class="content-field" data-content-field={fieldKey} data-limit={limit}>
  <span class="content-field__label">{label}</span>
  <span class="content-field__key">{fieldKey}</span>
  {multiline
    ? <textarea name={fieldKey} form={formId} required rows={rows}>{initialValue}</textarea>
    : <input name={fieldKey} form={formId} required type="text" value={initialValue} />}
  <span class="content-field__meta">
    <span class="content-field__error" data-field-error aria-live="polite"></span>
    <span class="content-field__counter" data-counter>0/{limit}</span>
  </span>
</label>
