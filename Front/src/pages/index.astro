---
/**
 * Página principal — composición de secciones.
 * Patrón de secciones activables: doc 05, sección 4.
 * Rediseño editorial: Hero + Servicios + Galería Netflix + Cotizador Drawer.
 */
import LayoutBase from "../layouts/LayoutBase.astro";
import Hero from "../components/Hero.astro";
import Servicios from "../components/Servicios.astro";
import Galeria from "../components/Galeria.astro";
import Cotizador from "../components/Cotizador.astro";
import BotonWhatsapp from "../components/BotonWhatsapp.astro";
import { siteConfig } from "../config/site";
---

<LayoutBase>
  <Hero />
  <Servicios />
  {siteConfig.secciones.galeria && <Galeria />}
  <Cotizador />
  <BotonWhatsapp />
</LayoutBase>
