---
import DocumentLayout from '../layouts/DocumentLayout.astro';
import Shell from '../visual/components/public/redesign/Shell.astro';
import Home from '../visual/components/public/redesign/Home.astro';
import Archive from '../visual/components/public/redesign/Archive.astro';
import About from '../visual/components/public/redesign/About.astro';
import Contact from '../visual/components/public/redesign/Contact.astro';
import Services from '../visual/components/public/redesign/Services.astro';
import Quote from '../visual/components/public/redesign/Quote.astro';
import Lightbox from '../visual/components/public/redesign/Lightbox.astro';
import UpdateNotice from '../visual/components/shared/UpdateNotice.astro';
import '../visual/styles/public/redesign/tokens.css';
import '../visual/styles/public/redesign/shell.css';
import '../visual/styles/public/redesign/home.css';
import '../visual/styles/public/redesign/archive.css';
import '../visual/styles/public/redesign/about-contact.css';
import '../visual/styles/public/redesign/services.css';
import '../visual/styles/public/redesign/profile-avatar.css';
import '../visual/styles/public/redesign/service-gallery.css';
import '../visual/styles/public/redesign/overlays.css';
import { enlaceWhatsapp } from '../features/cotizacion/whatsapp';
---
<DocumentLayout tituloDocumento="Corporación Artística Antony Rodríguez">
  <Shell />
  <main id="app-main"><Home/><Archive/><About/><Contact/><Services/></main>
  <Quote/><Lightbox/>
  <a id="boton-whatsapp" class="app-whatsapp" href={enlaceWhatsapp('Hola, quiero conversar sobre un proyecto artístico.')} target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp">
    <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M16.01 3C9.16 3 3.59 8.56 3.59 15.4c0 2.18.58 4.31 1.68 6.18L3.5 28.5l7.14-1.87a12.37 12.37 0 005.37 1.23c6.85 0 12.42-5.56 12.42-12.4S22.86 3 16.01 3zm0 22.62c-1.85 0-3.66-.5-5.24-1.43l-.38-.22-3.9 1.02 1.04-3.8-.25-.39A10.15 10.15 0 015.8 15.4c0-5.63 4.58-10.2 10.21-10.2 5.63 0 10.21 4.57 10.21 10.2 0 5.63-4.58 10.22-10.21 10.22zm5.6-7.64c-.31-.15-1.82-.9-2.1-.99-.28-.1-.49-.16-.69.15-.2.31-.79.99-.97 1.2-.18.2-.36.23-.66.08-.31-.16-1.3-.48-2.47-1.53-.91-.82-1.53-1.82-1.71-2.13-.18-.31-.02-.47.13-.63.14-.14.31-.36.46-.54.16-.18.2-.31.31-.52.1-.2.05-.38-.03-.54-.08-.15-.69-1.67-.95-2.28-.25-.6-.5-.52-.69-.53h-.59c-.2 0-.54.08-.82.38-.28.31-1.08 1.06-1.08 2.58s1.1 2.99 1.26 3.2c.15.2 2.17 3.31 5.26 4.65.74.32 1.31.51 1.76.65.74.24 1.41.2 1.94.12.59-.09 1.82-.74 2.08-1.46.26-.72.26-1.33.18-1.46-.08-.13-.28-.2-.59-.36z" />
    </svg>
  </a>
  <UpdateNotice />
</DocumentLayout>
<script>
import { iniciarPublico } from '../features/redesign';
import { iniciarPwa } from '../features/pwa';
iniciarPublico();iniciarPwa();
</script>
