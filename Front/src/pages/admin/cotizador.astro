---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ContentField from '../../visual/components/admin/contenido/ContentField.astro';
import { camposCotizadorFijos } from '../../../../Shared/contracts/cotizador';
import defaults from '../../../../Shared/contracts/textos.json';
const copyFields = [
  ['quote.eyebrow', 'Texto superior'], ['quote.title', 'Título del cotizador'], ['quote.description', 'Introducción'],
  ['quote.ideaTitle', 'Título del paso Obra'], ['quote.ideaDescription', 'Instrucción del paso Obra'],
  ['quote.measurementsTitle', 'Título del paso Medidas'], ['quote.measurementsDescription', 'Instrucción del paso Medidas'],
  ['quote.contactTitle', 'Título del paso Contacto'], ['quote.contactDescription', 'Instrucción del paso Contacto'],
].map(([key, label]) => {
  const field = defaults[key as keyof typeof defaults];
  return { key, label, initialValue: field.valor, limit: field.max, multiline: key.toLowerCase().endsWith('description'), rows: key === 'quote.description' ? 3 : 2 };
});
---
<AdminLayout titulo="Cotizador — Admin" seccionActiva="cotizador">
  <section class="quote-admin">
    <header><p>FORMULARIO PÚBLICO</p><h2>Cotizador</h2><span>Edita los textos de presentación y configura los campos. La secuencia de pasos, las claves y las validaciones se mantienen protegidas.</span></header>
    <section class="quote-copy" aria-labelledby="quote-copy-heading">
      <div><h3 id="quote-copy-heading">Títulos e instrucciones</h3><p>Estos textos aparecen al abrir el cotizador. Los nombres de los pasos y los botones se mantienen fijos para conservar el flujo.</p></div>
      <form id="quote-copy-form">
        <div class="quote-copy__fields">
          {copyFields.map((field) => <ContentField fieldKey={field.key} label={field.label} initialValue={field.initialValue} limit={field.limit} multiline={field.multiline} rows={field.rows} formId="quote-copy-form" />)}
        </div>
        <div class="quote-copy__save"><p id="quote-copy-status" role="status" aria-live="polite">Cargando textos guardados…</p><div><button id="quote-copy-discard" type="button" disabled>Descartar</button><button id="quote-copy-save" type="submit" class="button-primary" disabled>Guardar textos</button></div></div>
      </form>
    </section>
    <section class="quote-fields" aria-labelledby="quote-fields-heading"><h3 id="quote-fields-heading">Campos del cotizador</h3><p>Configura los nombres visibles, qué campos aparecen y cuáles son obligatorios. Los límites de respuesta y tipos de campo permanecen fijos.</p>
    <form id="quote-fields-form">
      {camposCotizadorFijos.map((field) => <article data-quote-field={field.id}>
        <div><strong>{field.etiqueta}</strong><code>{field.id}</code><small>Paso {field.paso} · {field.tipo} · límite {field.limite}</small></div>
        <label>Nombre visible<input data-label maxlength="60" value={field.etiqueta} required /></label>
        <label><input data-enabled type="checkbox" checked={field.habilitado} /> Mostrar campo</label>
        <label><input data-required type="checkbox" checked={field.requerido} /> Obligatorio</label>
      </article>)}
      <p id="quote-fields-status" role="status"></p><button class="button-primary" type="submit">Guardar formulario</button>
    </form>
    </section>
  </section>
</AdminLayout>
<style is:global>
  .quote-admin{max-width:1000px;margin:2rem auto;padding:0 1rem 5rem;color:#254044}.quote-admin>header{display:grid;gap:.5rem;margin-bottom:1.5rem}.quote-admin>header p{color:#d9a520;letter-spacing:.12em}.quote-admin h2{font:clamp(2rem,5vw,3.2rem) 'Cormorant Garamond',serif;margin:0}.quote-admin h3{font:1.8rem 'Cormorant Garamond',serif;margin:0}.quote-admin>header span,.quote-copy>div>p,.quote-fields>p{color:#748080}.quote-copy,.quote-fields{margin:1.5rem 0;padding:1.25rem;border:1px solid #ddd;background:#fff}.quote-copy>div{margin-bottom:1rem}.quote-copy form,.quote-fields form{display:grid;gap:.8rem}.quote-copy__fields{display:grid;grid-template-columns:1fr 1fr;gap:.25rem 1.25rem}.quote-copy .content-field{display:block;margin:1rem 0}.quote-copy .content-field__label{display:block;font-weight:600;margin-bottom:.3rem}.quote-copy .content-field__key{display:block;color:#98a29f;font: .75rem monospace;margin-bottom:.4rem}.quote-copy .content-field input,.quote-copy .content-field textarea{box-sizing:border-box;width:100%;padding:.8rem;border:1px solid #d7dcda;border-radius:4px;color:#254044;font:inherit}.quote-copy .content-field textarea{min-height:84px;resize:vertical}.quote-copy .content-field__meta{display:flex;justify-content:space-between;min-height:1.3rem;padding-top:.2rem}.quote-copy .content-field__error{color:#b45f62;font-size:.75rem}.quote-copy .content-field__counter{margin-left:auto;color:#98a29f;font-size:.75rem}.quote-copy .content-field__counter.is-near-limit{color:#d9a520}.quote-copy .content-field__counter.is-over-limit{color:#b45f62}.quote-copy [aria-invalid=true]{border-color:#b45f62!important}.quote-copy__save{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-top:1rem;border-top:1px solid #e5e8e6}.quote-copy__save p{color:#748080;font-size:.85rem}.quote-copy__save>div{display:flex;gap:.5rem}.quote-admin article{display:grid;grid-template-columns:1fr minmax(220px,1fr) auto auto;align-items:center;gap:.8rem;padding:1rem;border:1px solid #ddd;background:white}.quote-admin article>div{display:grid;gap:.25rem}.quote-admin code,.quote-admin small{color:#748080;font-size:.8rem}.quote-admin label{display:flex;align-items:center;gap:.45rem}.quote-admin input[data-label]{width:100%;padding:.6rem;border:1px solid #ccc;border-radius:4px}.quote-admin .button-primary{justify-self:end;background:#d9a520;border:0;padding:.8rem 1.2rem;font-weight:700;border-radius:4px;color:#12262a}.quote-admin button:disabled{opacity:.5;cursor:not-allowed}@media(max-width:760px){.quote-copy__fields{grid-template-columns:1fr}.quote-copy__save{align-items:flex-start;flex-direction:column}.quote-copy__save>div{width:100%}.quote-copy__save button{flex:1}.quote-admin article{grid-template-columns:1fr 1fr}.quote-admin article>div,.quote-admin article label:first-of-type{grid-column:1/-1}}
</style>
<script>
  import { apiFetch } from '../../lib/auth';
  type Field = { id: string; etiqueta: string; requerido: boolean; habilitado: boolean };
  const form = document.querySelector<HTMLFormElement>('#quote-fields-form')!;
  const status = document.querySelector<HTMLElement>('#quote-fields-status')!;
  const baseline = new Map<string, Field>();
  const copyForm = document.querySelector<HTMLFormElement>('#quote-copy-form')!;
  const copyFields = [...copyForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-content-field] input, [data-content-field] textarea')];
  const copyBaseline = new Map<string, string>();
  const copyStatus = document.querySelector<HTMLElement>('#quote-copy-status')!;
  const copySave = document.querySelector<HTMLButtonElement>('#quote-copy-save')!;
  const copyDiscard = document.querySelector<HTMLButtonElement>('#quote-copy-discard')!;
  let copyLoaded = false;
  let allowCopyNavigation = false;
  const copyLimit = (field: HTMLInputElement | HTMLTextAreaElement) => Number(field.closest<HTMLElement>('[data-content-field]')?.dataset.limit || 0);
  function copyError(field: HTMLInputElement | HTMLTextAreaElement) {
    const value = field.value.trim();
    if (!value) return 'Este campo es obligatorio.';
    if (value.length > copyLimit(field)) return `Supera el límite de ${copyLimit(field)} caracteres.`;
    return '';
  }
  function updateCopyField(field: HTMLInputElement | HTMLTextAreaElement) {
    const wrapper = field.closest<HTMLElement>('[data-content-field]')!;
    const counter = wrapper.querySelector<HTMLElement>('[data-counter]')!;
    const error = wrapper.querySelector<HTMLElement>('[data-field-error]')!;
    const invalid = copyError(field);
    const show = field.dataset.touched === 'true';
    counter.textContent = `${field.value.length}/${copyLimit(field)}`;
    counter.classList.toggle('is-near-limit', field.value.length >= Math.ceil(copyLimit(field) * .9) && field.value.length <= copyLimit(field));
    counter.classList.toggle('is-over-limit', field.value.length > copyLimit(field));
    error.textContent = show ? invalid : '';
    field.setAttribute('aria-invalid', String(Boolean(show && invalid)));
  }
  function updateCopyState(showErrors = false) {
    copyFields.forEach((field) => {
      if (showErrors) field.dataset.touched = 'true';
      updateCopyField(field);
    });
    const dirty = copyFields.some((field) => field.value !== copyBaseline.get(field.name));
    const invalid = copyFields.some((field) => Boolean(copyError(field)));
    copySave.disabled = !copyLoaded || !dirty || invalid;
    copyDiscard.disabled = !copyLoaded || !dirty;
    if (copyStatus.dataset.locked !== 'true') copyStatus.textContent = dirty ? `● ${copyFields.filter((field) => field.value !== copyBaseline.get(field.name)).length} cambios sin guardar` : 'Todo guardado';
  }
  async function loadCopy() {
    const response = await apiFetch('/api/contenido');
    if (!response.ok) throw Error('No se pudieron cargar los textos del cotizador.');
    const data = await response.json();
    for (const field of copyFields) {
      if (typeof data.textos?.[field.name] === 'string') field.value = data.textos[field.name];
      copyBaseline.set(field.name, field.value);
    }
    copyLoaded = true;
    updateCopyState();
  }
  copyFields.forEach((field) => {
    field.addEventListener('input', () => { delete copyStatus.dataset.locked; field.dataset.touched = 'true'; updateCopyState(); });
    field.addEventListener('blur', () => { field.dataset.touched = 'true'; updateCopyField(field); updateCopyState(); });
  });
  copyDiscard.addEventListener('click', () => {
    copyFields.forEach((field) => { field.value = copyBaseline.get(field.name) || ''; field.dataset.touched = 'false'; });
    delete copyStatus.dataset.locked;
    updateCopyState();
  });
  copyForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    updateCopyState(true);
    if (copyFields.some((field) => Boolean(copyError(field)))) return;
    const changed = copyFields.filter((field) => field.value !== copyBaseline.get(field.name));
    if (!changed.length) return;
    copyStatus.dataset.locked = 'true';
    copyStatus.textContent = 'Guardando…';
    copySave.disabled = true;
    let saved = false;
    try {
      const response = await apiFetch('/api/textos', { method: 'PUT', body: JSON.stringify({ textos: Object.fromEntries(changed.map((field) => [field.name, field.value.trim()])) }) });
      if (!response.ok) throw Error((await response.json()).error?.mensaje || 'No se pudieron guardar los textos.');
      changed.forEach((field) => { field.value = field.value.trim(); copyBaseline.set(field.name, field.value); field.dataset.touched = 'false'; });
      copyStatus.textContent = 'Textos guardados.';
      saved = true;
    } catch (error) { copyStatus.textContent = (error as Error).message; }
    finally {
      if (saved) window.setTimeout(() => { delete copyStatus.dataset.locked; updateCopyState(); }, 2500);
      else { delete copyStatus.dataset.locked; updateCopyState(); }
    }
  });
  async function load() {
    const response = await apiFetch('/api/cotizador/campos');
    if (!response.ok) throw Error('No se pudo cargar la configuración del cotizador.');
    const data = await response.json();
    for (const field of data.campos as Field[]) {
      baseline.set(field.id, field);
      const row = form.querySelector<HTMLElement>(`[data-quote-field="${field.id}"]`)!;
      (row.querySelector('[data-label]') as HTMLInputElement).value = field.etiqueta;
      (row.querySelector('[data-required]') as HTMLInputElement).checked = field.requerido;
      (row.querySelector('[data-enabled]') as HTMLInputElement).checked = field.habilitado;
      (row.querySelector('[data-required]') as HTMLInputElement).disabled = !field.habilitado;
    }
  }
  void loadCopy().catch((error) => { copyStatus.textContent = error.message; });
  form.addEventListener('change', (event) => {
    const row = (event.target as HTMLElement).closest<HTMLElement>('[data-quote-field]');
    if (!row) return;
    const enabled = row.querySelector<HTMLInputElement>('[data-enabled]')!;
    const required = row.querySelector<HTMLInputElement>('[data-required]')!;
    required.disabled = !enabled.checked;
    if (!enabled.checked) required.checked = false;
  });
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const campos = [...form.querySelectorAll<HTMLElement>('[data-quote-field]')].map((row) => ({ id: row.dataset.quoteField, etiqueta: row.querySelector<HTMLInputElement>('[data-label]')!.value, requerido: row.querySelector<HTMLInputElement>('[data-required]')!.checked, habilitado: row.querySelector<HTMLInputElement>('[data-enabled]')!.checked }));
    try {
      const response = await apiFetch('/api/cotizador/campos', { method: 'PUT', body: JSON.stringify({ campos }) });
      if (!response.ok) throw Error((await response.json()).error?.mensaje || 'No se pudo guardar la configuración.');
      status.textContent = 'Formulario guardado.';
      await load();
    } catch (error) { status.textContent = (error as Error).message; }
  });
  window.addEventListener('beforeunload', (event) => {
    if (copyLoaded && copyFields.some((field) => field.value !== copyBaseline.get(field.name)) && !allowCopyNavigation) event.preventDefault();
  });
  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    const dirty = copyLoaded && copyFields.some((field) => field.value !== copyBaseline.get(field.name));
    if (!link || !dirty || link.target || link.href.startsWith('javascript:')) return;
    const destination = new URL(link.href, location.href);
    if (destination.origin === location.origin && destination.pathname === location.pathname && destination.search === location.search) return;
    if (!window.confirm('Tienes cambios sin guardar. ¿Quieres salir de esta página?')) event.preventDefault();
    else allowCopyNavigation = true;
  });
  void load().catch((error) => { status.textContent = error.message; });
</script>
