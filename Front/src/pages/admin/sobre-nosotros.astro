---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ContentField from '../../visual/components/admin/contenido/ContentField.astro';
import defaults from '../../../../Shared/contracts/textos.json';
const aboutFields = [
  { key: 'about.photoCaption', label: 'Título de la galería', multiline: false, rows: 1 },
  { key: 'about.eyebrow', label: 'Texto superior', multiline: false, rows: 1 },
  { key: 'about.title', label: 'Título principal', multiline: false, rows: 1 },
  { key: 'about.titleAccent', label: 'Palabra destacada', multiline: false, rows: 1 },
  { key: 'about.description', label: 'Descripción', multiline: true, rows: 5 },
].map((field) => ({ ...field, initialValue: defaults[field.key as keyof typeof defaults].valor, limit: defaults[field.key as keyof typeof defaults].max }));
---
<AdminLayout titulo="Sobre nosotros — Admin" seccionActiva="sobre-nosotros">
  <section class="about-admin" data-admin-view="about-admin">
    <header class="about-admin__intro">
      <p>CONTENIDO DEL SITIO</p>
      <h2>Sobre nosotros</h2>
      <span>Edita aquí la presentación y administra las fotografías de esta sección.</span>
    </header>

    <section class="about-admin__card" aria-labelledby="about-copy-heading">
      <div class="about-admin__section-heading">
        <h3 id="about-copy-heading">Textos de la sección</h3>
        <p>Título, presentación y encabezado de la galería.</p>
      </div>
      <form id="about-text-form" class="about-admin__fields">
        {aboutFields.map((field) => <ContentField fieldKey={field.key} label={field.label} initialValue={field.initialValue} limit={field.limit} multiline={field.multiline} rows={field.rows} formId="about-text-form" />)}
        <div class="about-admin__save-row">
          <p id="about-text-status" role="status" aria-live="polite">Cargando textos guardados…</p>
          <div><button type="button" id="about-text-discard" disabled>Descartar</button><button type="submit" id="about-text-save" class="button-primary" disabled>Guardar textos</button></div>
        </div>
      </form>
    </section>

    <section class="about-admin__card" aria-labelledby="about-gallery-heading">
      <div class="about-admin__section-heading">
        <h3 id="about-gallery-heading">Galería fotográfica</h3>
        <p>Hasta 20 imágenes autorizadas. Puedes cambiar el orden o quitar una fotografía.</p>
      </div>
      <form id="about-photo-upload" class="about-admin__upload">
        <label for="about-photo-file">Agregar fotografía</label>
        <input id="about-photo-file" type="file" accept="image/jpeg,image/png,image/webp" required />
        <label for="about-photo-alt">Texto alternativo</label>
        <input id="about-photo-alt" maxlength="160" placeholder="Fotografía de la Corporación Artística Antony Rodríguez" />
        <button class="button-primary" type="submit">Subir fotografía</button>
        <p id="about-photo-message" role="status" aria-live="polite"></p>
      </form>
      <p id="about-photo-count" class="about-admin__count"></p>
      <div id="about-photo-list" class="admin-photo-gallery__grid"></div>
    </section>
  </section>
</AdminLayout>
<style is:global>
  .about-admin{max-width:1050px;margin:2rem auto;padding:0 1rem 5rem;color:#254044}.about-admin__intro{display:grid;gap:.5rem;margin-bottom:1.5rem}.about-admin__intro>p{color:#d9a520;letter-spacing:.12em;font-size:.75rem}.about-admin__intro h2{font:clamp(2rem,5vw,3.2rem) 'Cormorant Garamond',serif;margin:0}.about-admin__intro>span,.about-admin__section-heading p{color:#748080}.about-admin__card{padding:1.25rem;margin:1rem 0;border:1px solid #ddd;background:#fff}.about-admin__section-heading{margin-bottom:1rem}.about-admin__section-heading h3{font:1.65rem 'Cormorant Garamond',serif;margin:0 0 .2rem}.about-admin__fields{display:grid;gap:.2rem}.about-admin .content-field{display:block;margin:1rem 0}.about-admin .content-field__label{display:block;font-weight:600;margin-bottom:.3rem}.about-admin .content-field__key{display:block;color:#98a29f;font: .75rem monospace;margin-bottom:.4rem}.about-admin .content-field input,.about-admin .content-field textarea,.about-admin__upload input{box-sizing:border-box;width:100%;padding:.8rem;border:1px solid #d7dcda;border-radius:4px;color:#254044;font:inherit}.about-admin .content-field textarea{min-height:100px;resize:vertical}.about-admin .content-field__meta{display:flex;justify-content:space-between;min-height:1.3rem;padding-top:.2rem}.about-admin .content-field__error{color:#b45f62;font-size:.75rem}.about-admin .content-field__counter{margin-left:auto;color:#98a29f;font-size:.75rem}.about-admin .content-field__counter.is-near-limit{color:#d9a520}.about-admin .content-field__counter.is-over-limit{color:#b45f62}.about-admin [aria-invalid=true]{border-color:#b45f62!important}.about-admin__save-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-top:1px solid #e5e8e6;margin-top:1rem;padding-top:1rem}.about-admin__save-row p,.about-admin__count{color:#748080;font-size:.85rem}.about-admin__save-row>div{display:flex;gap:.5rem}.about-admin button{padding:.65rem 1rem;border:1px solid #ccd2d0;border-radius:4px;background:white;color:#254044;cursor:pointer}.about-admin button:disabled{opacity:.5;cursor:not-allowed}.about-admin .button-primary{background:#d9a520;border-color:#d9a520;color:#12262a;font-weight:700}.about-admin__upload{display:grid;gap:.65rem;padding:1.25rem;border:1px solid #e3e5e4;background:#fafaf8}.about-admin__upload label{font-size:.9rem}.about-admin__upload .button-primary{width:100%}.about-admin__upload p{margin:0;color:#748080}.about-admin__count{margin:.8rem 0}.admin-photo-gallery__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem}.admin-photo-gallery__grid article{border:1px solid #ddd;padding:.7rem;background:white}.admin-photo-gallery__grid img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}.admin-photo-gallery__grid small{display:block;margin-top:.4rem;color:#526361}.admin-photo-gallery__actions{display:flex;gap:.4rem;margin-top:.5rem}.admin-photo-gallery__actions button:last-child{margin-left:auto}@media(max-width:600px){.about-admin__save-row{align-items:flex-start;flex-direction:column}.about-admin__save-row>div{width:100%}.about-admin__save-row button{flex:1}.admin-photo-gallery__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<script>
  import { apiFetch } from '../../lib/auth';
  type Photo = { id: string; imagenUrl: string; texto_alternativo: string; orden: number };
  type Editable = HTMLInputElement | HTMLTextAreaElement;
  const textForm = document.querySelector<HTMLFormElement>('#about-text-form')!;
  const textStatus = document.querySelector<HTMLElement>('#about-text-status')!;
  const textSave = document.querySelector<HTMLButtonElement>('#about-text-save')!;
  const textDiscard = document.querySelector<HTMLButtonElement>('#about-text-discard')!;
  const textFields = [...textForm.querySelectorAll<Editable>('[data-content-field] input, [data-content-field] textarea')];
  const textBaseline = new Map<string, string>();
  const photoList = document.querySelector<HTMLElement>('#about-photo-list')!;
  const photoStatus = document.querySelector<HTMLElement>('#about-photo-message')!;
  let photos: Photo[] = [];
  let loaded = false;
  let photosLoaded = false;
  let allowNavigation = false;
  const safe = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[char]!));
  const changed = (field: Editable) => loaded && field.value !== textBaseline.get(field.name);
  const limitOf = (field: Editable) => Number(field.closest<HTMLElement>('[data-content-field]')?.dataset.limit || 0);
  function errorOf(field: Editable) {
    const value = field.value.trim();
    const limit = limitOf(field);
    if (!value) return 'Este campo es obligatorio.';
    if (value.length > limit) return `Supera el límite de ${limit} caracteres.`;
    if (field.name === 'about.titleAccent') {
      const title = (textForm.elements.namedItem('about.title') as Editable).value;
      if (!title.toLocaleLowerCase().includes(value.toLocaleLowerCase())) return 'La palabra debe aparecer dentro del título.';
    }
    return '';
  }
  function updateTextField(field: Editable, showError = false) {
    const wrapper = field.closest<HTMLElement>('[data-content-field]')!;
    const counter = wrapper.querySelector<HTMLElement>('[data-counter]')!;
    const error = wrapper.querySelector<HTMLElement>('[data-field-error]')!;
    const message = errorOf(field);
    const show = showError || field.dataset.touched === 'true';
    counter.textContent = `${field.value.length}/${limitOf(field)}`;
    counter.classList.toggle('is-near-limit', field.value.length >= Math.ceil(limitOf(field) * .9) && field.value.length <= limitOf(field));
    counter.classList.toggle('is-over-limit', field.value.length > limitOf(field));
    error.textContent = show ? message : '';
    field.setAttribute('aria-invalid', String(Boolean(show && message)));
  }
  function updateTextState(showErrors = false) {
    textFields.forEach((field) => updateTextField(field, showErrors));
    const dirty = textFields.some(changed);
    const invalid = textFields.some((field) => Boolean(errorOf(field)));
    textSave.disabled = !loaded || !dirty || invalid;
    textDiscard.disabled = !loaded || !dirty;
    if (textStatus.dataset.locked !== 'true') textStatus.textContent = dirty ? `● ${textFields.filter(changed).length} cambios sin guardar` : 'Todo guardado';
  }
  async function loadText() {
    const response = await apiFetch('/api/contenido');
    if (!response.ok) throw Error('No se pudieron cargar los textos guardados.');
    const data = await response.json();
    for (const field of textFields) {
      const value = data.textos?.[field.name];
      if (typeof value === 'string') field.value = value;
      textBaseline.set(field.name, field.value);
    }
    loaded = true;
    updateTextState();
  }
  async function loadPhotos() {
    const response = await apiFetch('/api/about/photos');
    if (!response.ok) throw Error('No se pudieron cargar las fotografías.');
    photos = (await response.json()).fotos;
    photosLoaded = true;
    document.querySelector('#about-photo-count')!.textContent = `${photos.length}/20 fotografías`;
    photoList.innerHTML = photos.map((photo, index) => `<article><img src="${safe(photo.imagenUrl)}" alt="${safe(photo.texto_alternativo)}"><small>${index + 1}. ${safe(photo.texto_alternativo)}</small><div class="admin-photo-gallery__actions"><button type="button" data-move="up" data-id="${safe(photo.id)}" ${index===0?'disabled':''}>Subir</button><button type="button" data-move="down" data-id="${safe(photo.id)}" ${index===photos.length-1?'disabled':''}>Bajar</button><button type="button" data-delete-photo="${safe(photo.id)}">Eliminar</button></div></article>`).join('') || '<p>Aún no se agregaron fotografías.</p>';
  }
  textFields.forEach((field) => {
    field.addEventListener('input', () => { delete textStatus.dataset.locked; field.dataset.touched = 'true'; updateTextState(); });
    field.addEventListener('blur', () => { field.dataset.touched = 'true'; updateTextField(field); updateTextState(); });
  });
  textForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    updateTextState(true);
    if (textFields.some((field) => Boolean(errorOf(field)))) return;
    const updates = textFields.filter(changed);
    if (!updates.length) return;
    textStatus.dataset.locked = 'true';
    textStatus.textContent = 'Guardando…';
    textSave.disabled = true;
    let saved = false;
    try {
      const response = await apiFetch('/api/textos', { method: 'PUT', body: JSON.stringify({ textos: Object.fromEntries(updates.map((field) => [field.name, field.value.trim()])) }) });
      if (!response.ok) throw Error((await response.json()).error?.mensaje || 'No se pudieron guardar los textos.');
      updates.forEach((field) => { field.value = field.value.trim(); textBaseline.set(field.name, field.value); field.dataset.touched = 'false'; });
      textStatus.textContent = 'Textos guardados.';
      saved = true;
    } catch (error) { textStatus.textContent = (error as Error).message; }
    finally {
      if (saved) window.setTimeout(() => { delete textStatus.dataset.locked; updateTextState(); }, 2500);
      else { delete textStatus.dataset.locked; updateTextState(); }
    }
  });
  textDiscard.addEventListener('click', () => {
    textFields.forEach((field) => { field.value = textBaseline.get(field.name) || ''; field.dataset.touched = 'false'; });
    updateTextState();
  });
  photoList.addEventListener('click', async (event) => {
    const target = event.target as HTMLButtonElement;
    const move = target.dataset.move;
    const id = target.dataset.id;
    if (move && id) {
      const index = photos.findIndex((photo) => photo.id === id);
      const next = index + (move === 'up' ? -1 : 1);
      if (index < 0 || next < 0 || next >= photos.length) return;
      [photos[index], photos[next]] = [photos[next], photos[index]];
      target.disabled = true;
      const response = await apiFetch('/api/about/photos/order', { method: 'PUT', body: JSON.stringify({ ids: photos.map((photo) => photo.id) }) });
      if (!response.ok) photoStatus.textContent = 'No se pudo guardar el orden.';
      await loadPhotos();
    }
    const removeId = target.dataset.deletePhoto;
    if (removeId && window.confirm('¿Quitar esta fotografía de Sobre nosotros?')) {
      const response = await apiFetch(`/api/about/photos/${removeId}`, { method: 'DELETE' });
      photoStatus.textContent = response.ok ? 'Fotografía quitada.' : 'No se pudo quitar la fotografía.';
      await loadPhotos();
    }
  });
  document.querySelector<HTMLFormElement>('#about-photo-upload')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    const file = document.querySelector<HTMLInputElement>('#about-photo-file')!.files?.[0];
    if (!file || photos.length >= 20) { photoStatus.textContent = 'La galería admite hasta 20 fotografías.'; return; }
    photoStatus.textContent = 'Subiendo fotografía…';
    try {
      const grant = await apiFetch('/api/imagenes-sitio/upload-url', { method: 'POST', body: JSON.stringify({ nombreArchivo: file.name, tipoMime: file.type }) });
      if (!grant.ok) throw Error('Formato no permitido. Usa JPEG, PNG o WebP.');
      const { uploadUrl, imagenKey } = await grant.json();
      const uploaded = await fetch(uploadUrl, { method: 'PUT', headers: { 'Content-Type': file.type }, body: file });
      if (!uploaded.ok) throw Error('No se pudo transferir la imagen.');
      const saved = await apiFetch('/api/about/photos', { method: 'POST', body: JSON.stringify({ imagenKey, textoAlternativo: (document.querySelector<HTMLInputElement>('#about-photo-alt')!).value }) });
      if (!saved.ok) throw Error((await saved.json()).error?.mensaje || 'No se pudo guardar la fotografía.');
      photoStatus.textContent = 'Fotografía agregada.';
      (event.target as HTMLFormElement).reset();
      await loadPhotos();
    } catch (error) { photoStatus.textContent = (error as Error).message; }
  });
  window.addEventListener('beforeunload', (event) => { if (textFields.some(changed) && !allowNavigation) event.preventDefault(); });
  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!link || !textFields.some(changed) || link.target || link.href.startsWith('javascript:')) return;
    const destination = new URL(link.href, location.href);
    if (destination.origin === location.origin && destination.pathname === location.pathname && destination.search === location.search) return;
    if (!window.confirm('Tienes cambios sin guardar. ¿Quieres salir de esta página?')) event.preventDefault();
    else allowNavigation = true;
  });
  void Promise.all([loadText(), loadPhotos()]).catch((error) => {
    if (!loaded) textStatus.textContent = (error as Error).message;
    if (!photosLoaded) photoStatus.textContent = (error as Error).message;
  });
</script>
