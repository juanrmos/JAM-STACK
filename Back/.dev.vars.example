# Solo para desarrollo local. Crear Back/.dev.vars con `npm run secrets:init:local`.
# Se necesitan JWT_SECRET y ADMIN_SECRET de prueba; la subida local usa el binding R2.
# No copiar secretos productivos ni configurar CF_ACCESS_TEAM en pruebas locales.

JWT_SECRET=replace-with-random-local-value
ADMIN_SECRET=replace-with-random-local-value
